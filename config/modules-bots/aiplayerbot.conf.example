# How far a healer will look for someone to heal, and how far it will walk to
# reach them. Both the target choice, the "out of spell range" trigger and the
# approach action read this, so it has to stay inside what the heals can actually
# reach - 40 yards in this Vanilla/Tortoise realm. It shipped as 125, which meant a healer
# sixty yards away thought it was in position, never closed the gap, and failed
# every cast.
AiPlayerbot.HealDistance = 30

# The same for battlegrounds, where tighter is better. Previously this was a hard
# halving of the value above, which tied the two together for no good reason.
AiPlayerbot.HealDistanceBg = 25

# Travel/terrain lookups run inline on the world thread when disabled (safe).
# Cores whose MMapManager does not support concurrent tile loading (e.g.
# vmangos) MUST keep this at 0 to avoid a worker-thread SIGSEGV; set 1 only on
# cores with concurrent terrain support.
# AiPlayerbot.AsyncTravelPartitions = 0
