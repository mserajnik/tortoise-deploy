##########################################
# MANGOS Ai Playerbot Configuration file #
##########################################

# Every `#Key = value` line below shows the default that already runs.
# Uncomment a line only to change it; an active line sets the value.

[AiPlayerbotConf]
ConfVersion=2020072501

# Enable or disable AI Playerbot (default 1). Set 0 to keep the module built in
# but inert: no pool bots and no bot AI, a plain server.
AiPlayerbot.Enabled = 1

# Enable Observability telemetry UDP emitter for the dashboard (default 1)
# This is turned off by default in tortoise-deploy because it does not provide
# the observability dashboard.
AiPlayerbot.Observability = 0
AiPlayerbot.ObservabilityPort = 9195
# Mobs, threat and target lines for every dungeon run on the dashboard's Dungeons tab (only acts with Observability = 1)
AiPlayerbot.ObservabilityDungeonMobs = 1
# Raids tab: leader, offline members and the live fight window of every raid group, without a commander bind (only acts
# with Observability = 1; the fight window needs AiPlayerbot.CombatMonitor = 1 in this file). On only when both this
# file and the world config say 1; 0 in either turns it off (re-read on .reload config).
AiPlayerbot.ObservabilityRaids = 0
# Raids tab detail: the ready check and the boss debuffs, appended at the END of the RAIDS line (only acts with
# ObservabilityRaids = 1 here and in the world config; sent at most every 5 s). 0 in either turns it off.
AiPlayerbot.ObservabilityRaidsDetail = 0

# Enable random bot system
# On by default: a fresh install brings up a living world of random bots
# (see MinRandomBots/MaxRandomBots, RandomBotAutoCreate). 0 turns the pool off
# and leaves only manually added bots (`.bot add <name>`).
AiPlayerbot.RandomBotAutologin = 1

# Log on all random bots on start
AiPlayerbot.RandomBotLoginAtStartup = 1

# Disable automatic DBStore save
AiPlayerbot.ExplicitDbStoreSave = 0

# Log out random bots after BotInWorldTime interval
# AiPlayerbot.RandomBotTimedLogout = 1

# Level ladder: choose the next random bot to log in by level instead of round-robin over
# the whole pool. The levels are cut into bands of LevelLadderBandSize (1-5, 6-10, ... 56-59)
# plus level 60 on its own; every low band gets an equal share of the online target and
# level 60 gets LevelLadderMaxLevelShare percent of it (a hard cap - the other 60s stay
# offline as a reserve). The band with the largest shortfall is filled first, inside a band
# the highest-level character logs in first, so the leaders keep playing until they reach 60
# and the fresh characters wait in the pool until a slot frees up. Once every
# LevelLadderLogMinutes the service logs the online count per band.
# Default: 1 (on). 0 restores the round-robin over the whole pool.
# AiPlayerbot.LevelLadder = 1
# AiPlayerbot.LevelLadderBandSize = 5
# AiPlayerbot.LevelLadderMaxLevelShare = 10
# AiPlayerbot.LevelLadderLogMinutes = 5

# Login Bots when real players login
# AiPlayerbot.RandomBotLoginWithPlayer = 0

# Random bot count. Default 500 is sized for an average PC or a Steam Deck
# (with the self-tuning tick budget below); a bigger machine can raise both.
AiPlayerbot.MinRandomBots = 500
AiPlayerbot.MaxRandomBots = 500
AiPlayerbot.RandomBotMaxLevel = 60

# Username prefix used when the module NAMES a new pool account, and when the
# server console previews legacy accounts for explicit adoption. It never
# authorizes ownership: only accounts listed in the character-database table
# `tortoise_bots_pool_account` are managed pool accounts. An account that
# merely looks like a bot account (for example RNDBOTPersonal) is ignored by
# the pool and is never reset.
AiPlayerbot.RandomBotAccountPrefix = RNDBOT

# Managed random-bot pool reset (issue #265). One string setting:
#   off                - normal operation; existing bot progression is kept (default)
#   once:<token>       - rebuild the pool once, on the next server start, when
#                        <token> differs from the last completed generation.
#                        Re-using the same token is a no-op, so the value can
#                        safely stay in this file after it has been applied.
#   always             - DEVELOPMENT ONLY. Rebuild the pool on every server
#                        start; every bot's progression, gear, professions,
#                        hires, pinned names and all-pool guilds are lost.
# Anything else is invalid: it is logged and no reset happens.
#
# A reset deletes the characters on managed pool accounts (the login accounts
# themselves are kept) and then regenerates them, so it needs
# AiPlayerbot.RandomBotAutoCreate = 1; without auto-create the reset is refused
# instead of leaving an empty pool. The setting is read only during initial
# world startup: `.reload config` never starts a reset, and there is no live
# reset command. Existing installations must first enroll their hand-made
# accounts at the server console with `bot pool adopt preview` and
# `bot pool adopt confirm <challenge>`; until then those accounts are not
# managed and are never touched. See docs/server/bot-pool.md.
AiPlayerbot.RandomBotPoolReset = off

# Bounded idempotent RNDBOT population (feature 01). Default OFF.
# When 1, the service reuses existing RNDBOT% accounts/characters and creates
# only the deficit toward the configured Min/Max target, throttled to at most
# one character per RandomBotUpdateInterval (no per-tick DB scans, no blocking
# loop). Accounts are allocated via AccountMgr.CreateAccount with a random
# password (hashed via CalculateShaPassHash, never logged), characters via
# CharacterCreation::CreateCharacter on the world thread (requires core PR #416
# Handlers/CharacterCreation.h). Valid race/class is the intersection of DBC
# ChrRaces/ChrClasses (NOT_PLAYABLE filtered) and PlayerInfo/playercreateinfo;
# DBC-missing combos are never selected and an empty intersection disables
# auto-create for this process (log once). Duplicate names/accounts are avoided
# via UNIQUE checks. Existing accounts with mixed-faction cached candidates are
# deterministically excluded (derived from all cached RNDBOT characters for that
# account) and the service tries the next eligible account in the same cadence,
# so one failed account does not block the deficit. Permanently failed accounts
# (mixed, limit, or other materialization errors) are logged once and never
# retried every RandomBotUpdateInterval (reset only on Initialize/restart);
# transient CHAR_CREATE_ERROR/DB-count failures and dynamic
# CHAR_CREATE_DISABLED/CHAR_CREATE_PVP_TEAMS_VIOLATION (faction-balance/
# creation-disabled) are retryable with ~60s backoff (log throttled) and do not
# permanently exclude healthy accounts, while name collisions
# (NAME_IN_USE/RESERVED/PROFANE) are retried silently and remain retryable.
# LoginDatabase allocation failures are throttled to one log per ~60s and retried
# after the interval. A successful CreateAccount whose id is not yet visible
# (LoginDatabase async after AllowAsyncTransactions, separate from core PR #416) is
# remembered as exactly one pending name and retried with
# bounded/log-throttled cadence while continuing existing-account creation
# without allocating another fresh account (log once after prolonged unresolved
# period, no duplication/spin, no 20-orphan loop). After a fresh-account permanent failure,
# further fresh RNDBOT account allocation is disabled for this process (log once)
# while valid existing accounts remain eligible. Successful creates are appended
# to the normal Headless login (AddRandomBot -> LoginPlayer) and post-login
# PlayerbotFactory gear enrichment (already in RandomBotService.Update) handle
# them. No raw INSERT, no DB worker, no AddAsyncTask.
AiPlayerbot.RandomBotAutoCreate = 1

# Optional pinned RNDBOT names that remain online when possible. Comma-separated
# character names matched using the database's stored `characters.name` collation
# (separate from the teleport facade's normalized comparison); resolved once at
# startup to GUIDs in the discovered RNDBOT pool, prioritized within
# MaxRandomBots and exempt from timed logout (native login teleport is skipped
# separately via the facade's normalized name match, best-effort) but still
# gated by RandomBotLoginWithPlayer=1 (entire pool stays offline until a human
# is present).
# Names that do not exist or are not in the RNDBOT pool are logged and ignored.
# No new table, no PID, no core changes. Default empty (disabled).
#AiPlayerbot.PinnedBots =

# Scatter RNDBOT headless logins to a validated level-appropriate overworld
# GenericRpg destination. Level is validated via persisted ai_playerbot_zone_level
# first (with parent-zone cached fallback) then immutable DBC AreaTable AreaLevel
# / parent AreaLevel fallback; a stock empty table therefore does not make the
# feature permanently no-op. No DB scan, world scan, cache generation, or lazy
# GetAreaLevel creature scan is performed. The GenericRpg destination cache
# itself requires AutoDoQuests=1 (otherwise no destinations and the feature
# fails closed); invalid coords, unresolved area flag (zero), or unavailable
# terrain/navmesh also retain logout position. Only applied once on headless
# login via the generic PlayerScript OnLogin hook, only for BotManager records
# marked random; owned/manual bots unchanged. Pinned bots
# (sRandomBotFacade.IsPinnedBot) and dead or ghost bots (which stay with
# their corpse) are skipped. Uses core Player::TeleportTo on
# the world thread; no homebind update. Default 1, so bots seeded above level
# 10 start in a zone that fits their level instead of their starting zone.
AiPlayerbot.EnableRandomTeleports = 1

# Whether random bots are allowed in custom isolated starting zones
# (Blackstone Island 5536, Thalassian Highlands 5225, Alah'Thalas 2040).
# Default 0 (blocked, normalized to mainland starter zones).
AiPlayerbot.AllowIsolatedCustomStartingZones = 0

# Spread new random bots evenly across the six racial starting zones instead
# of piling orc/troll/goblin into Valley of Trials, human/high elf into
# Elwynn and dwarf/gnome into Dun Morogh while Tirisfal, Mulgore and
# Teldrassil sit empty. Auto-create picks a valid race from the
# least-populated start zone; isolated-custom-zone normalization sends the
# bot to the least-populated standard start of its faction (both use the
# core playercreateinfo spawns). Set 0 for the old behaviour: uniform random
# race, goblins to Valley of Trials, high elves to Northshire. Default 1.
AiPlayerbot.RandomBotEvenStartZones = 1
# % of new random bots that are Alliance (0-100); the rest are Horde.
# 50 = no bias (today's mix). Faction is rolled first, then the start zone
# inside that faction (weights below, else RandomBotEvenStartZones). Account
# faction limits still apply: a roll with no valid race on the account keeps
# the full account-eligible list, and core creation limits back off as today.
# Only new bots and the login preference below follow it; existing pool bots
# are never deleted or moved (use RandomBotPoolReset for a hard restart).
# Login preference: when the ratio is not 50, the level ladder prefers the
# faction furthest below its share as bots rotate in; no forced logouts. It
# applies only while the ladder is filling bands (LevelLadder=1, online below
# target); full pools and LevelLadder=0 are unaffected.
# e.g. 90 for a mostly-Alliance pool. Default 50.
AiPlayerbot.RandomBotFactionRatio = 50

# Optional per-start-zone weights for new random bots, e.g.
# "Durotar=100,Elwynn=50". Names are region names (Durotar, Mulgore,
# Tirisfal, Elwynn, Dun Morogh, Teldrassil) or spawn names (Northshire,
# Coldridge, ...). Empty = today's even spread. A zone with weight 0 gets no
# new bots through this pick; malformed (or all-zero) text logs an error and
# keeps the even spread. Applies within the rolled faction above. e.g. all
# new bots in Durotar: AiPlayerbot.RandomBotStartZoneWeights = Durotar=100.
# Bots seeded level 10+ still scatter to level-fitting zones at first login,
# so weighted zones only control where level-1 bots start. Default empty.
AiPlayerbot.RandomBotStartZoneWeights =

# Names for new bot characters (pool bots and hires), as percentages of three
# styles: race-flavoured,compound,fun. Race-flavoured names fit the bot's race
# and gender ("Thorvin" for a dwarf), compound names join two words with a
# class lean ("Nightrunner"), fun names are puns and nods ("Kidneyshotz",
# "Gnomebody"). Every name passes the same checks as a player's name. Only new
# characters follow it; existing bots keep their names. 100,0,0 = serious
# names only, 0,0,100 = fun names only. Default 55,20,25.
AiPlayerbot.RandomBotNameStyleWeights = 55,20,25

# Optional text file with more names, added to the built-in ones. Same format
# as runtime/BotNameData.h: a [key] line, then names separated by spaces or
# new lines, e.g. "[fun:rogue]" then "Stabbyjoe Sneakypants". Keys: fun,
# fun:<class>, fun:<race>, rp:<race>:<male|female> (samples for race names),
# start, start:<class>, end, prefix:<class|race>, suffix, pet:hunter.
# Read once at the first name pick; restart to reload. Default empty.
AiPlayerbot.RandomBotNamesFile =

# Where a random bot without a player master comes back after a repop (the
# evacuation used when it keeps dying or is stuck while dead): 1 = nearest
# graveyard, like a player at the spirit healer; 0 = its racial starting area
# (the old behaviour, which drained bots back into the starting zones).
# Default 1.
AiPlayerbot.RepopAtGraveyard = 1
# Teleport a dead bot out of a hopeless corpse run (grim clueless solo graveyard
# with no reachable spirit) to the graveyard it would repop at
#AiPlayerbot.RelocateHopelessDeaths = 1
# Level at which random bots learn the Swift Riding Turtle (quest 40302
# "Torta's Egg" -> item 23720 -> spell 30174), as if they did the quest.
# Applies on seed/refresh at TurtleMountAtLevel..39 and on level-up for the
# masterless random pool; level 40+ behaviour is unchanged (normal mount +
# riding, epic at 60). 0 disables. Default 18.
AiPlayerbot.TurtleMountAtLevel = 18
# Organic level-up mounts: a random pool bot that dings 40 or 60 learns the
# same mount the seed/hire path grants (slow mount at 40, epic at 60, with
# the riding skill already level-gated). 1 = on; 0 = off, so a bot levelled
# from 1 keeps only the turtle until it is re-seeded. Default 1.
AiPlayerbot.LevelUpMounts = 1
# Random pool bots and hired companions ride only mounts that fit their own
# race, i.e. the strict own-race vendor mounts a player of that race would buy
# (normal from 40, epic from 60). Cross-race mounts, shop mounts that any race
# can use, and mounts that drop from loot (raid/dungeon bosses), are left out.
# 1 = any mount, including shop and raid-drop mounts (old behaviour).
# Player alts are never gated. Default 0.
AiPlayerbot.RandomBotShopMounts = 0
# Safety factor on the mount break-even distance: bots mount for travel/RPG
# trips only when the remaining distance exceeds
# 7 y/s * mount cast time / (best mount speed % / 100) * this. 0 disables
# the threshold (mount for any trip).
# Turtle 9% (~3 s cast) -> ~350 y; 60% -> ~50 y; 100% -> ~30 y. Default 1.5.
AiPlayerbot.MountBreakEvenFactor = 1.5


# Whether a random bot without a player master avoids hostile towns: 1 = travel
# destinations and grind targets guarded by town guards hostile to its team are
# refused (guards kill bots ~13 levels above them); 0 = the old behaviour, which
# walked bots into enemy settlements. Default 1.
AiPlayerbot.AvoidHostileTowns = 1

# When a random bot without a player master is stuck for a long time it uses its
# hearthstone. 1 = only if its homebind area is within 10 levels of the bot
# (otherwise it repops instead); 0 = skip the level check (the old behaviour, which
# parked outgrown bots in their starting zones). The distance gate below still
# applies either way. Default 1.
AiPlayerbot.UnstuckHearthLevelFit = 1

# How far a "long stuck" bot must be from its own homebind before a hearthstone
# is worth casting, in yards. Closer than this the hearth only throws the bot back
# into the same camp (a level 1 starting zone is a few hundred yards wide) while
# burning its 30-minute cooldown, so the unstuck chain repops to the nearest
# graveyard instead. 0 disables the gate (always hearth). Default 300.
AiPlayerbot.UnstuckHearthMinDistance = 300

# Stuck-travel teleport for random bots without a player master (owned and hired
# bots never teleport). 1 = a trip that fails or makes no progress for six moves
# in a row (the point where the destination would be dropped) teleports the bot
# to its destination instead: onto the navmesh next to it, or the nearest route
# node within 200 yards. Same map only, only when no player is near either end,
# at most once per 10 minutes per bot. It frees bots stranded swimming at sea,
# where no walk can reach land. 0 = drop the destination and pick another (the
# old behaviour). Default 1.
AiPlayerbot.StuckTravelTeleport = 1

# Guild-order auction leg: an arrived trip at a committed auction house with no
# auctioneer in interact range moves the leg down the ladder after this many
# visits (0 disables the exit, the leg keeps waiting for a seller). Default 3.
AiPlayerbot.GuildOrderAuctionVisits = 3

# Quest-log upkeep for random bots without a player master: drop finished
# quests that can no longer be rewarded (except transient money blockers),
# drop grey incomplete deliver quests whose items are gone, refuse grey
# quests unless the reward is an equip upgrade, clean a nearly-full log only
# when something is droppable, and stay in turn-in travel once 2 quests are
# finished until none remain. Owned and alt bots are never affected. 0
# restores the old accept-all / clean-only-grey / hand-in-at-5 behaviour.
# Default 1.
AiPlayerbot.BotQuestLogUpkeep = 1
# AI-side outgrown-zone rule (no teleports: bots walk/fly/boat via the travel
# graph). 1 = a random masterless bot at level 10+ in a non-capital zone it
# outlevels by 5+ — or idling in a capital with no pending trainer/mount/AH/
# Vendor/Repair need — requests a level-band Grind travel target (above AH/
# Vendor/Repair relevance), refuses services and inn homebinds in zones 10+
# below its level (capitals excepted); 0 = the old behaviour, which let bots
# sit in outgrown zones and bind there. Unknown area levels fail closed.
# A level 10+ pool bot whose travel target has been reset back to back for
# 2 min also requests that Grind target, for that one trip, whatever needs
# are pending.
# Default 1.
AiPlayerbot.LeaveOutgrownZones = 1

# Vendor trip thresholds (#339): when a bot walks to a vendor. Either the sell
# value of its vendor-usable stock covers the money missing for the next
# trainable class rank, or the batch below fires: at least VendorBatchMinCount
# vendor-usable items and bags at least VendorBatchMinBagSpace percent full.
# The batch half stands on its own — a bot with nothing left to train (a fresh
# level 1 has no green class rank yet) still sells instead of hoarding loot.
# Bots below level 5 use the LowLevel* pair instead — a fresh bot carries one
# or two greys, so 8 items / 60% bags never applied to the starting pool and it
# stayed broke. Default 8 / 60, low level 3 / 25.
AiPlayerbot.VendorBatchMinCount = 8
AiPlayerbot.VendorBatchMinBagSpace = 60
AiPlayerbot.LowLevelVendorBatchMinCount = 3
AiPlayerbot.LowLevelVendorBatchMinBagSpace = 25
# Radius in yards of the vendor trip a random masterless bot below level 5 may
# make. All RPG travel below level 5 stays blocked (the path to an NPC usually
# crosses level 5+ mobs); the camp vendor is the exception, and the trip is
# capped to this radius so the bot never leaves its mob-safe starting pocket.
# Default 600.
AiPlayerbot.LowLevelVendorMaxDistance = 600

# Microseconds a travel-destination pick may spend scanning candidates per bot
# visit before yielding to the next visit (the pick resumes where it stopped,
# accepting the same target, just spread across visits). Bounds the worst-case
# single-bot update so one 11 s pick no longer lands whole in a world tick.
# 0 = no slicing (the whole pick runs in one visit). Default 4000 (4 ms).
AiPlayerbot.TravelPickBudgetUs = 4000

# Bot-only drop-rate boost for green (uncommon) and blue (rare) items. Masterless
# random pool bots roll each quality-2/3 entry of a creature's loot template one extra
# time per kill, at (multiplier - 1) x the entry's DB chance, so the expected number of
# greens/blues per kill is roughly the multiplier times the normal rate. Quest items,
# quest starters, unique items already held and entries that never yield quality 2/3
# are never boosted; players and hired/alt bots keep the server's own rates, and loot
# shared with a group is never touched. Each hit is logged to bot_events.csv as a
# "BotLootBonus" row (creature name, "quality:itemId:itemName"). 1.0 = off.
#AiPlayerbot.BotLootRateUncommon = 1.0
#AiPlayerbot.BotLootRateRare = 1.0

# Default-on bounded fill of human-waiting LFT queues with live random Headless bots.
# Uses core #416 QueuePlayer/LeaveQueue/IsQueued/IsInOffer/AcceptOffer/
# GetQueuedPlayers; core owns private queues, offers, cancellation and groups.
# Candidates use AiFactory roles and the hardcoded Turtle client LFT LFT_Data.lua
# minLevel/maxLevel range table (see LftBotFillService.cpp; no DBC fallback),
# not an average-human +/-5 approximation. Unknown/corrupt/custom ranges fail
# closed and log once.
# Rate-limited/reconciled; no role hook, addon-string injection, private-map access,
# second queue, or DB query per tick. Requires #411 Headless and #416. Default 1.
#AiPlayerbot.RandomBotLftEnabled = 1
#AiPlayerbot.RandomBotLftUpdateInterval = 15000
#AiPlayerbot.RandomBotLftMaxFillsPerInterval = 1
# Issue #189: allow the LFT fill to respec a bot into a missing role (role
# borrowing). Default 0 keeps each bot's own spec; a missing role stays empty
# with a logged reason instead of being filled badly.
#AiPlayerbot.RandomBotLftAllowRoleBorrow = 0

# Issue #192: on-demand companion hiring (.bot hire + <Mercenary Hire> inn
# recruiters, entries 95000-95045). Party hires 1-4 escalate (~15g total at
# 60); raid hires 5+ use the flat bulk rate. All scale linearly with level.
#AiPlayerbot.HireEnabled = 1
#AiPlayerbot.HireMinAccountSecurity = 0
# Up to 39 (a raid you play in holds you and 39); the commander of a bound raid, who stands outside it,
# may hire a 40th into the bound raid when this is 39.
#AiPlayerbot.HireMaxBotsPerPlayer = 4
# Issue #936: `.bot hire <class> ... [level]` (or level=<n>) hires the
# companion at a chosen level, 1 up to the hirer's level plus this many (0-59,
# never above 60). 0 = no higher than the hirer; a GM hirer may go to 60. Any
# level below the hirer is allowed. No level given = the hirer's level, as ever.
#AiPlayerbot.HireMaxLevelAboveHirer = 0
# Free hires for staff: accounts with this security level or more hire
# companions for free (no gold taken; the reply says "free (GM)"). 0 = off,
# everyone pays. Account levels on this core: 1 observer, 2 moderator,
# 3 developer, 4 administrator; e.g. 2 = moderators and up hire free. Range 0-6.
#AiPlayerbot.HireFreeMinSecurity = 0
# HireAnywhere: 0 = hire only at a <Mercenary Hire> recruiter (the .bot hire
# command points players to one); 1 = .bot hire also works anywhere. Fees are
# the same either way.
#AiPlayerbot.HireAnywhere = 0
# HireAllowPvP: 0 = hired companions are PvE-only (queueing for a battleground
# warns once, entering dismisses them, hiring is refused while queued or
# inside). 1 = today's behaviour (hires may go to battlegrounds).
#AiPlayerbot.HireAllowPvP = 0
# HireLoot: 1 = hired companions loot corpses and roll on group loot.
# 0 (default) = a hire never loots: it passes on every roll and leaves every
# corpse alone. Hires never quest, whatever this is set to.
#AiPlayerbot.HireLoot = 0
# ShamanTankEnabled: 1 = the experimental 7.3 shaman tank build (Enhancement
# (Tank)) is offered at recruiters and by `.bot hire`, and random pool shamans
# may roll it. 0 = withheld everywhere. Shamans already on the build keep it.
#AiPlayerbot.ShamanTankEnabled = 1
#AiPlayerbot.HireBaseCostCopper = 15000
#AiPlayerbot.HirePartyMult2 = 1.66
#AiPlayerbot.HirePartyMult3 = 2.66
#AiPlayerbot.HirePartyMult4 = 4.66
#AiPlayerbot.HireRaidFlatCostCopper = 10000
#AiPlayerbot.HireDisconnectGracePeriod = 300
# Issue #900: `.bot hire raid <preset|composition> [tier]` hires a whole raid
# through the single-hire path (up to HireMaxBotsPerPlayer minus the
# companions you already have). A role count like `3t 12h 24d` picks its
# classes from HireRaidSpread: per role (tank, healer, dps) a comma list of
# classes handed out round-robin; repeat a class to weight it. Classes your
# faction cannot field are skipped. HireRaidPresets: `name=composition`
# entries separated by `;`, run as `.bot hire raid <name> [tier]`; the
# composition may end in a tier word (a tier typed after the name wins).
# The values below are the values that actually run.
#AiPlayerbot.HireRaidSpread = tank=warrior,druid,paladin;healer=priest,priest,paladin,shaman,druid;dps=mage,warlock,rogue,hunter,warrior,mage,warlock,rogue,hunter,shaman
#AiPlayerbot.HireRaidPresets = zg=2t 4h 13d t2;aq20=2t 4h 13d t5;onyxia=3t 10h 26d t3;mc=3t 10h 26d t3;bwl=3t 10h 26d t4;aq40=3t 10h 26d t5;naxx=3t 10h 26d t6
# Named gear presets for `.bot gear <target> preset <name>`: `name=t<tier> [ilvl=<cap>]`, `;`-separated. The tier is the hire gear tier
# (1 pre-raid, 2 ZG/AQ20/Lower Karazhan, 3 Molten Core/Onyxia/Timbermaw, 4 BWL/Emerald Sanctum, 5 AQ40, 6 Naxxramas, 7 Tower of Karazhan);
# the cap keeps every item at or under that item level.
AiPlayerbot.BotGearPresets = prebis=t1 ilvl=63;lkh=t2 ilvl=63;zg=t2 ilvl=63;aq20=t2 ilvl=63;t1=t3 ilvl=66;timbermaw=t3 ilvl=66;onyxia=t3 ilvl=66;mc=t3 ilvl=66;t2=t4 ilvl=76;bwl=t4 ilvl=76;es=t4 ilvl=76;aq40=t5 ilvl=78;naxx=t6 ilvl=83;kara40=t7 ilvl=88
# Issue #490: static best-in-slot sets for level-60 hires (tiers 1-7 from
# the tortoise_bots_hire_gear table). 0 = today's random hire gear only.
# HireGearStartTier (0..7) is the tier every player has. Higher tiers are
# unlocked by seven quests at the six capital recruiters (one per tier:
# kill the tier's bosses, bring materials, pay a fee). The recruiter's
# "Choose equipment" step and `.bot hire <tier>` pick any tier from 0 up to
# the player's highest; the default is tier 0.
# HireGearUnlockAccountWide = 1: an unlock on any character of the account
# counts. HireGearAllQuestsAvailable = 1: all seven quests are offered at
# once instead of as a chain (written into the quests at startup, live
# after the NEXT restart). HireGearOptionalMaps: comma-separated map ids
# whose bosses are credited automatically when the quest is taken, e.g.
# 819 (Timbermaw Hold) or all Turtle content 800,532,819,807,814; their
# loot stays in the gear pool. HireGearTierCostMultipliers: hire fee
# multiplier for tiers 0..7 (exactly 8 numbers, else the defaults are used).
# The values below are the values that actually run.
#AiPlayerbot.HireGearTiersEnabled = 1
#AiPlayerbot.HireGearStartTier = 0
#AiPlayerbot.HireGearUnlockAccountWide = 0
#AiPlayerbot.HireGearAllQuestsAvailable = 0
#AiPlayerbot.HireGearOptionalMaps =
#AiPlayerbot.HireGearTierCostMultipliers = 1,1.5,2,3,4,5,6,6
# Standard (tier 0) companion kit: generated item level <= hire level + this
# value, and never above RandomGearMaxLevel. Default 5 = a little above the
# pool rule (RandomGearMaxItemLevelAboveLevel, 1) and below the tier-2 curated
# kit: a level-60 standard hire tops out at item level 65, the tier-1 ceiling.
# The curated tier 1-7 sets are not affected. 0 keeps RandomGearMaxLevel alone.
#AiPlayerbot.HireGearMaxItemLevelAboveLevel = 5
# Issue #492: world buffs at the six capital <Mercenary Hire> recruiters
# (Stormwind, Ironforge, Darnassus, Orgrimmar, Undercity, Thunder Bluff).
# Level 60+ players get a "World buffs" branch next to "Hire bots"; the
# branch lists buy options (price = base + per-person x head count, head
# count = buyer + grouped members within 40 yd of the NPC) and the unlock
# quests. Unlock fees are paid when an unlock quest is turned in:
# WorldBuffsUnlockFeeRaidCopper for Rallying Cry, Warchief's Blessing and
# Spirit of Zandalar (200g), WorldBuffsUnlockFeeCopper for the rest (100g).
# The server writes them into the quests at startup, so a changed fee is
# live after the NEXT restart (restart twice). The values below are the
# values that actually run.
#AiPlayerbot.WorldBuffsEnabled = 1
#AiPlayerbot.WorldBuffsKeepInRaids = 0
#AiPlayerbot.WorldBuffsMinLevel = 60
#AiPlayerbot.WorldBuffsPriceBaseCopper = 100000
#AiPlayerbot.WorldBuffsPricePerPersonCopper = 20000
#AiPlayerbot.WorldBuffsSaygePriceBaseCopper = 60000
#AiPlayerbot.WorldBuffsSaygePricePerPersonCopper = 10000
#AiPlayerbot.WorldBuffsSongflowerPriceBaseCopper = 40000
#AiPlayerbot.WorldBuffsSongflowerPricePerPersonCopper = 10000
#AiPlayerbot.WorldBuffsSilithystPriceBaseCopper = 20000
#AiPlayerbot.WorldBuffsSilithystPricePerPersonCopper = 4000
#AiPlayerbot.WorldBuffsUnlockFeeRaidCopper = 2000000
#AiPlayerbot.WorldBuffsUnlockFeeCopper = 1000000
# Ammo stacks (200 rounds each) a warrior or rogue with a bow, gun or
# crossbow keeps topped up (maintenance, level-up, ammo refill). Hunters keep
# 5 + level / 10 stacks as before and are not affected. 1-10, never more than
# a hunter of the same level gets; a bot with the item cheat keeps 1. The
# value below is the value that actually runs.
#AiPlayerbot.AmmoStacksNonHunter = 2
# Issue #473: opt-in quality of life for owned/hired bots only (every part
# off by default; pool bots always keep progressing organically and are
# never touched). The values below are the values that actually run.
#AiPlayerbot.OwnedBotMaintenanceEnabled = 0
#AiPlayerbot.OwnedBotAutogearEnabled = 0
# Autogear caps: quality 0 poor .. 5 legendary (default 2 = uncommon/green),
# ilvl 0 = no cap (clamped to 5 at load).
#AiPlayerbot.OwnedBotAutogearQualityCap = 2
#AiPlayerbot.OwnedBotAutogearIlvlCap = 0
# `.autogear` on real players: 0 = GM-only (a GM may gear any player), 1 =
# every player may run .autogear on themselves only. Never affects bots.
# The value below is the value that actually runs.
#AiPlayerbot.PlayerAutogearForAll = 0

# Summon the joining bot to its inviter on group accept, with the condition
# knobs below (dead bots are only revived when both the dead-bot and revive
# knobs are on; repair runs after arrival).
#AiPlayerbot.OwnedBotSummonWhenGroup = 0
#AiPlayerbot.OwnedBotSummonAllowInCombat = 0
#AiPlayerbot.OwnedBotSummonAllowMasterDead = 0
#AiPlayerbot.OwnedBotSummonAllowBotDead = 0
#AiPlayerbot.OwnedBotSummonRevive = 0
#AiPlayerbot.OwnedBotSummonRepair = 0
# Seconds between summon-on-accept teleports per bot (default 300 = 5
# minutes). 0 disables the cooldown (not recommended with revive/repair on).
#AiPlayerbot.OwnedBotSummonCooldown = 300

# Issue #884: remote commander. A GM, or the owner of every bot in it, binds a
# bot-only group of up to five to themselves with `.bot commander bind
# <LeadBot> [<Bot>...]` and leads it from anywhere (another zone, outside the
# instance) with `.bot cmd ...` orders that name their target by GUID or a 3D
# point; `.bot commander view` sends the TBM:VIEW feed. This is how an outside
# program (an AI agent such as turtle-agent) drives a party, so it is off by
# default: turn it on only if you run such a program. With 0 a player still
# binds his own party with `inparty` and uses `.bot cmd enter` and `.bot cmd summon`
# for the run leader (needs AiPlayerbot.DungeonSelfClear = 1); every other
# commander command answers that the feature is off.
#AiPlayerbot.RemoteCommander = 0

# Issue #884, phase 2: while a commander is bound and its feed is on (`.bot
# commander view on|off`; a new binding starts off), the commander receives
# one TBM:VIEW frame (the bound bots, the hostiles they see, the top of each
# engaged hostile's threat list) every this many milliseconds. Built from what
# the bots already track; no extra world scan. Clamped to 250..60000.
#AiPlayerbot.RemoteCommanderViewMs = 1000

# Raid entry by the commander. A raid's entrance can ask a player for something a bot
# never has (Onyxia's lair asks for the Drakefire Amulet quest reward). With 1, a bot's
# failed entrance condition is waived when the commander who bound it is a real player who
# commands the bot's raid (a member of it, or the binding's commander, whom a raid binding
# keeps outside the group) and meets that condition himself; with 0 the bot is refused as
# before.
# A five-player dungeon's condition is never waived, and neither is a scripted entrance's
# (the fallback teleport would skip the trigger's script). The entrance's other
# requirements (level, content phase, raid group, instance limit) are never waived, the
# commander must stand in the world, and the core still checks the instance itself.
# 0 - off: the bot's own condition decides
# 1 - on (Default)
#AiPlayerbot.RaidEntryByCommander = 1

# Work in progress. These features are not officially released and not supported yet. Enable them at your own risk.
# Until the official release, bug reports and feedback about them are not handled through the issue tracker; contact Hypeer directly.
# Run trace (opt-in, off by default). A GM, or the owner of the bots, runs
# `.bot trace start <run_id> [party|bot <Name>]` and the server records what the
# party's bots do - hp/power/position/target/strategy, the hostiles they see and
# who they hold, every action with its result (OK / FAILED / IMPOSSIBLE / USELESS /
# PREREQ / VETOED / BACKOFF), deaths, combat enter/leave, loot, facing and movement - as one JSONL
# file (<run_id>.jsonl) plus <run_id>.summary.json, until `.bot trace stop`.
# tools/trace_score.py scores the file offline. Schema: docs/server/run-trace.md.
# Costs nothing while no run is active; a run reads only what the bots already
# track (no world scan, no database), builds its lines on the world thread and
# writes them on a separate thread through a bounded queue (lines are dropped and
# counted if the disk cannot keep up). With 0 `.bot trace start` answers that the
# feature is off, and a run in progress ends at the next tick.
#AiPlayerbot.RunTrace.Enabled = 0

# Milliseconds between two frames of a run (clamped to 250..10000).
#AiPlayerbot.RunTrace.IntervalMs = 500

# Where traces are written; a relative path is under LogsDir.
#AiPlayerbot.RunTrace.Dir = traces

# Only a GameMaster may start a trace (each takes up to MaxFileMb of disk).
# With 0 the owner of the bots may start one too.
#AiPlayerbot.RunTrace.GmOnly = 1

# Size cap of one trace file in MiB (clamped to 1..1024). When it is reached the
# run ends (end reason size_cap) with its end record intact.
#AiPlayerbot.RunTrace.MaxFileMb = 64

# Decision capture (test servers only): while a dungeon run leader runs and this
# is on, every tick of its policy is written to a rotating JSONL capture under
# LogsDir/decisions: the whole facts it read and the whole run it saw, before
# and after the tick, with the order it decided. A live failure can then be cut
# into a replay fixture (tools/replay_decisions) and kept as a regression test.
# One record is roughly 12-40 KB at 1 Hz, so 45-145 MB per hour per run and
# about 300 MB for a two-hour walk; nothing is written while it is off.
# Format, files, privacy and the fixture workflow: docs/server/decision-capture.md.
#AiPlayerbot.DecisionCapture.Enabled = 0

# Where captures are written; a relative path is under LogsDir.
#AiPlayerbot.DecisionCapture.Dir = decisions

# A segment rotates past this many MiB (clamped to 1..256).
#AiPlayerbot.DecisionCapture.SegmentMiB = 32

# Segments of one capture past this many MiB are deleted oldest first
# (clamped to SegmentMiB..4096); the segment being written is never deleted.
#AiPlayerbot.DecisionCapture.CaptureMiB = 512

# The whole folder past this many MiB drops its oldest ended captures
# (clamped to CaptureMiB..65536). A running capture is never dropped.
#AiPlayerbot.DecisionCapture.TotalMiB = 4096

# A record larger than this is written as a stub and the next tick is a
# keyframe (clamped to 64..4096 KiB).
#AiPlayerbot.DecisionCapture.RecordKiB = 512

# A full keyframe every this many records, and always at a segment start
# (clamped to 1..600).
#AiPlayerbot.DecisionCapture.KeyframeEvery = 60

# Issue #1012: `.bot cmd gossip <npc entry> <bot> <option>` lets a commanded bot
# talk to an NPC and pick a gossip option (a commander's own order needs AiPlayerbot.RemoteCommander = 1; the run leader's gossip steps need only AiPlayerbot.DungeonSelfClear = 1). A gossip option can do anything its script says (take money,
# give items, teleport), so a bot talks only to the creature entries listed
# here, comma-separated, after you have read what their scripts do. Empty = the
# order is refused for every NPC (the default). Audited entries:
#   7607 Weegli Blastfuse (Zul'Farrak): after the pyramid event his one option
#        sends him to blow the End Door open; before it his menu is empty.
#   7604 Sergeant Bly (Zul'Farrak): after the pyramid event his one option starts
#        his fight (he and his crew turn hostile and attack the bot that asked).
# To allow both: AiPlayerbot.BotGossipNpcs = 7607,7604
# Since fix/plan-gossip-allow (SFK r27 slot7 stopped at step 130/313 when its
# plan's gossip step was refused Deathstalker Adamant, 3849), a dungeon run did
# not need this list for its own gossip steps: a bot of a running or paused run
# was let talk to the NPC entry the run's CURRENT gossip step names (the step's
# `entry` only), read from the loaded plan, and to no other. A manual
# order outside a run, another NPC, or a run at any other step still needed the
# entry listed here.
#AiPlayerbot.BotGossipNpcs =

# Bounded AH market population through the native bot/session auction path. Default off.
# When enabled, online random Headless bots use real inventory items, pricing, deposits,
# account limits, and HandleAuctionSellItem. Auctioneer spawns are loaded once and
# validated before a bounded TeleportTo fallback; no fake items, direct auction writes,
# donor AhBot thread, per-tick AH/DB scan, or second owner. Interval is 5..3600 seconds
# (default 120), batch is 1..5 (default 1), and the shared AH try_lock is respected.
# Requires RandomBotAutologin=1. Failed attempts are rate-limited per bot.
AiPlayerbot.AhMarketEnabled = 1
AiPlayerbot.AhMarketInterval = 120
AiPlayerbot.AhMarketBatchSize = 1

# Synthetic AH Supply and Buyer Engine with Work Budgets (Issue #88).
# Optional background service generating realistic synthetic market supply
# and buyer participation for low-population realms. Strictly bounded by
# per-tick time budgets and operation count caps so tick latency is unaffected.
# Synthetic inventory is isolated and tagged, never entering real inventories.
AiPlayerbot.AhMarketSyntheticSupply = 0
# AhMarketBuyer is not synthetic: a pool bot already standing at an auctioneer
# bids on or buys an auction with its own gold.
AiPlayerbot.AhMarketBuyer = 1
AiPlayerbot.AhMarketBudgetUs = 2000
AiPlayerbot.AhMarketMaxOperations = 32
AiPlayerbot.AhMarketChanceSell = 10
AiPlayerbot.AhMarketChanceBuy = 10
AiPlayerbot.AhMarketBuyValue = 80
AiPlayerbot.AhMarketMaxSpendPerBot = 0
AiPlayerbot.AhMarketMaxQuality = 4
AiPlayerbot.AhMarketMaxLevel = 60
AiPlayerbot.AhMarketDynamicLevel = 0
AiPlayerbot.AhMarketLevelRefresh = 600
AiPlayerbot.AhMarketVariance = 10
AiPlayerbot.AhMarketBidMin = 75
# AiPlayerbot.AhMarketBidMax = 90
AiPlayerbot.AhMarketTimeMax = 24
# AiPlayerbot.AhMarketTimeMin = 8
# Demand-aware WSG/AB/AV queue participation for live Headless RNDBOTs. Default on.
# Uses the native BattleGroundJoinAction/WorldSession handler path and the
# copy-only BattleGroundMgr queued-participant snapshot from core #416. No
# human-waiting queue means no bot queueing; otherwise bots match the observed
# queue type/bracket and fill BOTH sides up to the core's match minimum plus 1
# (e.g. AV 15 + 1), counting humans and bots already waiting, so a solo human's
# own side reaches the minimum too and no bot-only second match is left
# behind. Human demand is checked every 5 s with up to 10 bots per check (5 per
# side), so a match forms within seconds; the interval/budget below pace only
# the autonomous seeder (budget 0 still turns both off). Candidates are
# in-memory and checked for level, alive/idle/not queued/not in a BG, no deserter/taxi, and no
# active human master. WSG/AB group joins require every member to be a
# service-owned Headless bot; AV is always queued solo. Cadence is 5s..10m and
# the per-interval budget is 0..10. No second queue/thread, DB scan, arena,
# vehicle, or expansion BG behavior. Master-reclaim reconciliation only removes
# queue entries owned by this service. Requires core #411 and #416.
#AiPlayerbot.RandomBotBgEnabled = 1
#AiPlayerbot.RandomBotBgQueueInterval = 30000
#AiPlayerbot.RandomBotBgMaxQueuePerInterval = 1
# Autonomous bot-only Warsong Gulch (default on). When no human waits in any
# BG queue, seeds one 10v10 WSG in the most populated level bracket so pool
# bots have matches of their own. Top-up batches accumulate until both sides
# fill; a still-forming match keeps absorbing queued seeds, so only a full
# instance stops new seeds. Capped at 1 concurrent full instance for an
# average PC (20 bots on one map); clamped 0-2, raise to 2 only on a strong host.
#AiPlayerbot.RandomBotBgAutonomous = 1
#AiPlayerbot.RandomBotBgAutonomousMaxInstances = 1
# Note: the seeder runs inside the backfill tick, so it also requires
# AiPlayerbot.RandomBotBgEnabled = 1 (Autonomous=1 + BgEnabled=0 seeds nothing).

# 1 = every bot's AI is always fully active (botActiveAlone is ignored).
# 0 = activity priorities apply: bots near/visible to a player, in combat, in
#     an instance, grouped with a player or in a battleground stay active;
#     "alone" bots (no player nearby / empty map or server) are throttled to
#     botActiveAlone percent. All bots stay logged in either way; this only
#     limits how often their AI updates. If you get lag with 1, reduce the
#     number of online bots.
# Default 1 (bots always alive); throttling is an opt-in.
AiPlayerbot.DisableActivityPriorities = 1

# Force bots to become active when a player is nearby
#AiPlayerbot.ForceActiveWhenNearPlayer = 0

# Force bots to become active when guild orders are enabled
#AiPlayerbot.GuildOrderAlwaysActive = 1

# Guild orders may take missing reagents from the guild bank before shopping or farming.
# Default 1. Guild rank and bank tab permissions still apply.
AiPlayerbot.GuildOrderBankWithdraw = 1

# Bots always have the tools their recipes need (Arclight Spanner, Blacksmith Hammer...):
# a missing tool is added to the bags when the bot crafts, and bots never sell or auction tools.
# Default 1. 0 = only the item cheat adds tools, and bots may sell them.
AiPlayerbot.CraftToolsAlways = 1

# Guild orders may use guild bank money for auction house purchases after the bot's own gold.
# Default 1. Guild bank access is still limited by the core's rank rules.
AiPlayerbot.GuildOrderBankGold = 1
# Let players order finished goods from the auction house: 1 = `.bot order <bot> buy ...`
# works from chat and the addon shows Buy; 0 = Buy orders are refused (the bot still
# buys materials itself while it works on farm and craft orders). Default 0.
AiPlayerbot.GuildOrderPlayerBuy = 0
# Let working orders ask another guild bot to make or farm a missing reagent (a sub-order).
# Default 1. Each part of the supply chain has its own switch.
AiPlayerbot.GuildOrderSubOrders = 1

# How deep sub-orders may nest (ore, then bars, then armor): the same item never
# appears twice in one branch. Out of range values fall back to 3.
AiPlayerbot.GuildOrderSubOrderDepth = 3
# Guild bank access for guild bots: bots joining a guild with a real player
# get one shared rank (by default the guild's lowest rank, or the rank picked
# with `.bot order rank`) and bank tab 1 is kept open to it (from the next
# server start). Ranks a player gives bots by hand stay. 1 is on, 0 is off
# (ranks stay as they are and the addon shows no bot rank).
#AiPlayerbot.GuildOrderBotRank = 1

# Limit combat activity for slight performance boost.
#AiPlayerbot.LimitCombatActivity = 0

# Percentage (not a count) of "alone" bots kept fully active when
# DisableActivityPriorities = 0; the active set rotates ~1% per minute.
# Default is 10, higher numbers may affect performance
# AiPlayerbot.botActiveAlone = 10

# Sync non-random bot alt levels to master level automatically
# When enabled, bot alts will level up one level at a time to match their master's level
# AiPlayerbot.SyncAltLevelToMaster = 0

# Change random bot has lower gear
AiPlayerbot.RandomGearLoweringChance = 0.15

# Max item level of random equipment. Vanilla/Tortoise Naxxramas items reach
# roughly item level 100; keep the default bounded to that dataset.
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 81 | Tier 3 = 99
# Max iLVL Phase 1 = 71(MC, ONY, ZG) | Phase 2(BWL) = 77 | Phase 2.5(AQ) = 88 | Phase 3(NAXX) = 100 (NOT RECOMMENDED SINCE ILVL OVERLAPS BETWEEN TIERS)
AiPlayerbot.RandomGearMaxLevel = 100

# Owner rule (Oct 2026): generated gear is capped by the bot's own level too,
# so a wandering pool bot never wears raid loot it could not have earned.
# Generated item level <= bot level + this value, and never above
# RandomGearMaxLevel. Default 1: a level-60 pool bot tops out at item level 61.
# Fresh seeding and every later re-gear of a pool bot use it; gear a bot earns
# itself (loot, quest rewards, vendor and auction buys) is not capped. 0 keeps
# RandomGearMaxLevel alone.
AiPlayerbot.RandomGearMaxItemLevelAboveLevel = 1

# Max difference between bot level and item's required level to be used in randomisation
# Default = 9, means bots level 60 can use items that require (themselves or via quests) level 51 and above
AiPlayerbot.RandomGearMaxDiff = 9

# Seed gear progressively by bot level instead of throwing the full band at once
#AiPlayerbot.RandomGearProgression = 1
# One-time starter gear for fresh pool bots (level 5 and up): seeds a bot's gear
# at its first login while its played time is still 0, and for the timer backstop
# retry of a bot that never played. It does NOT upgrade gear as bots level up;
# after the seed a bot gears from loot, quest rewards and vendor buys.
#AiPlayerbot.RandomGearUpgradeEnabled = 1

# Owner-rule source-tier cap for seeded/hired bot gear (roadmap #289: higher
# tiers unlock later). 0 = base only (world drop, vendor, quest, allowed
# recipe); 1 = + end-game dungeons (Blackrock Spire 229, Scholomance 289,
# Stratholme 329, Karazhan Crypt 800); 2 = + raids. Computed per item with
# lowest-tier-source-wins and persisted in ai_playerbot_item_info_cache.
AiPlayerbot.RandomGearMaxSourceTier = 0

# Allow reputation-gated gear (item/quest/vendor-condition/recipe rep) on seeds.
AiPlayerbot.RandomGearAllowReputation = 0

# Allow PvP gear (NO_DISENCHANT rewards, honor rank) on seeds.
AiPlayerbot.RandomGearAllowPvP = 0

# Per-slot chance a fresh seed rolls a rare world-drop epic (loot-attested
# BoE world epics) instead of the normal green/blue band. Falls back to the
# normal band when the slot has no attested epic.
AiPlayerbot.RandomGearSeedEpicChance = 0.02

# Enable random tabards on randomisation
AiPlayerbot.RandomGearTabards = 0

# Chance to get a random tabard
AiPlayerbot.RandomGearTabardsChance = 0.1

# Replace guild tabard with random one
AiPlayerbot.RandomGearTabardsReplaceGuild = 0

# Comma-separated item IDs that no auto-gear path hands out, e.g.
# AiPlayerbot.RandomGearBlacklist = 12345,23456
# Item IDs are on database.turtle-wow.org. The default blocks the GM-only
# Gamemaster's Broom of Doom (10), the unobtainable trinket Fang of Alichos
# (58260), the prize hats Lucky Top Hat (163) and Lucky Fishing Hat (19972),
# and the event hats Red/Green Winter Hat (21524, 21525) and The Greatest
# Wizzard Hat (7); empty means nothing is blocked, and there is no
# separate on/off switch. The ban covers every auto-gear path including
# .autogear and the gear progression system, and wins over the whitelist
# below. A pool or hired bot already wearing a blocked item gets it replaced
# or removed on its next gear pass; real players and owned bots keep whatever
# they wear, and items a bot finds itself (loot, quest rewards, auction
# house) are unaffected.
# Besides this list, auto-gear (except the gear progression system and the
# curated hire kits) never hands out items players cannot really have: no
# known source (not dropped, sold, crafted, fished, found in a container or
# given by a quest), deprecated or test items, item level 0 outside shirt and
# tabard, and legendary or better. These rules are always on; a pool or hired
# bot wearing such an item gets it replaced the same way.
AiPlayerbot.RandomGearBlacklist = 10,163,19972,58260,21524,21525,7

# Item ids always seeded on random gear regardless of the scoring rules below,
# unless the id is also on the blacklist above. A whitelisted id also skips
# the "items players cannot really have" rules above.
#AiPlayerbot.RandomGearWhitelist =

# Roll need on items if slot is empty or broken, even if not appropriate for bot's spec
# Bots without real player master ignore this config and always roll need in that case
# 1 - roll need on such items
# 0 - roll greed on such items (Default)
AiPlayerbot.RollBadItemsWithPlayer = 0

# Build the optional character-database item caches (ai_playerbot_equip_cache and
# ai_playerbot_rnditem_cache) once, on the first startup that finds them empty.
# The generator walks the item prototypes a single time and writes the result in
# one transaction, which takes seconds; afterwards the caches are loaded from the
# database on every later startup. A fresh install therefore gears its bots
# without any manual SQL import.
# 1 - generate the caches while they are empty (Default)
# 0 - leave the caches alone; bots then only fill empty slots from loot
# The world weight scales (data/sql/world/20260916090001_world.sql) and the
# in-memory item info cache are always loaded and are not affected by this.
AiPlayerbot.GenerateItemCaches = 1

# Bot transport use style: 0 = walk on transports (currently not available), 1 = teleport on transports and ride it, 2 = teleport from dock to dock bypassing transport.
# AiPlayerbot.TransportTeleportType = 2

# Chance for bot to use potions
#AiPlayerbot.UsePotionChance = 1.0

# Bots will mount up to catch up when far behind the master while following.
# AiPlayerbot.BoostFollow = 1

# Dungeon follow: hold before a pack (audit fix 127).
# Inside a dungeon or raid, with the bot out of combat (the leader may be fighting), a bot whose leader is more
# than 30 yd ahead walks the route to the leader itself and stops just outside
# the aggro range of the first unpulled hostile creature on that route, instead
# of walking past or through it. It whispers its master once per pack ("pack in
# the way") and stands there; it does not eat or drink while it holds (it rests
# through the normal out-of-combat flow once the hold ends). It walks on when
# the pack is dead or gone or the route no longer passes it; when the leader
# comes back within 25 yd the normal follow takes over. Off by default.
# 0 - core follow, no pack check (Default)
# 1 - hold before packs in dungeons and raids
AiPlayerbot.DungeonFollowHoldBeforePacks = 0

# Warlock pet by spec.
# In PvE (open world and dungeons, not raids or PvP) a warlock summons the demon
# that fits its talent tree instead of always the Voidwalker (mod-playerbots
# parity, adapted to 1.12 which has no Felguard): Affliction and Demonology
# use the Felhunter, falling back to the Succubus, Voidwalker and Imp by what
# the warlock has learned; Destruction uses the Imp. A warlock whose group has
# no tank keeps the Voidwalker. The pet is chosen when the warlock has none;
# pool bots also swap a default demon they already have (needs a Soul Shard).
# A pet a player ordered (a "pet <demon>" strategy, or a demon a player's own
# bot already has) is never replaced. On by default.
# 0 - Voidwalker whenever learned, Imp before that
# 1 - pet that fits the spec (Default)
AiPlayerbot.WarlockPetBySpec = 1

# Warlock raid rotation.
# Stops the warlock rotation from spending casts on a target that is about to
# die, so the Shadow Bolt filler the raid measures actually goes out:
# - a DoT or curse (Corruption, Siphon Life, Immolate, the curse rows) only
#   starts on a target at 35 percent health or more, and a DoT spread to
#   another attacker only while that attacker is above 50 percent. Bosses
#   (world and raid bosses, instance-binding bosses, and the loaded dungeon
#   plan's bosses) and the raid-utility curses (Curse of the Elements,
#   Curse of Recklessness, Curse of Shadow) are never gated;
# - in a converted raid group (not a five-player party) each of the five
#   "on attacker" spread rows (Corruption, Siphon Life, Immolate, Curse of
#   the Elements, and the Curse of Agony spread) keeps at most two extra
#   targets dotted besides the current target. The count is per row and
#   counts the attackers already carrying that row's DoT or curse;
# - Drain Soul only harvests from trash (never from a boss or raid boss) and
#   only while the warlock holds fewer than two Soul Shards;
# - in combat Life Tap only fires when two Shadow Bolts cannot be paid for,
#   instead of at the 40 percent medium-mana line.
# Off by default; with 0 the rotation is unchanged.
# 0 - current rotation (Default)
# 1 - life gated, raid-capped rotation
AiPlayerbot.WarlockRaidRotation = 0

# Rogue threat drops in dungeons.
# In a grouped 5-man dungeon with a living tank in the fight, a rogue uses
# Feint when its threat on the current target is medium (60 percent of the
# tank's or more) and, if that is not enough, Vanish at critical threat (80
# percent and climbing) so it does not pull the mob off the tank. Vanish is
# only used while the mob is on the tank or the rogue; it is never used solo,
# without a tank, or in the open world. Raid rogues already do this (Feint at
# medium, Vanish at high) and are unchanged. The thresholds are the bots'
# existing medium and high threat levels. On by default.
# 0 - dungeon rogues do not shed threat
# 1 - Feint on medium threat, Vanish on critical threat in 5-man dungeons (Default)
AiPlayerbot.RogueDungeonThreatDrops = 1

# Rogue pre-pull Sap approach around the pack.
# A rogue sent to Sap its CC mark before the pull walks, stealthed, to a spot
# on the side of the mob away from its pack-mates, by a path that stays out of
# each pack-mate's stealth detection range (plus the range in which it turns
# to look, plus a margin), going round the pack if it must. Without Stealth up
# it waits. If no such spot and path exist the rogue skips that Sap for 30
# seconds and the tank pulls. Off by default.
# 0 - walk straight to the rogue's side of the mob (old behaviour) (Default)
# 1 - approach around the pack, skip the Sap when no safe route exists
AiPlayerbot.SapApproachAvoidPack = 0

# Warrior gap closers.
# Out of combat a warrior (tank or dps) whose target is 8-25 yards away and in
# sight swaps to Battle Stance if needed and uses Charge; a tank swaps back to
# Defensive Stance once in combat. A tank uses it on a mob already hitting a
# party member first (the pack a rogue or a healer pulled) and never on a
# crowd-controlled or held crowd-control mark. In combat a tank uses Intercept
# (Berserker Stance) on a mob hitting the healer or another non-tank member
# 8-25 yards away when the rage left after the stance swap (Tactical Mastery)
# pays for it, then swaps back to Defensive Stance and taunts; with too little
# rage it runs in. Inside a dungeon or raid an unengaged mob is only charged
# when it is the target of a melee pull order or an attack order. Off by
# default; with 0 only the old rows remain (Charge only from the stance the
# warrior is already in, as the walk in closes).
# 0 - no stance swap for Charge or Intercept (Default)
# 1 - Charge to open, tank Intercept to rescue a party member
AiPlayerbot.WarriorGapCloser = 0

# Hunter Aspect of the Viper on low mana.
# A hunter that has learned Aspect of the Viper (Turtle 1.18.1 spell 45651,
# trainer level 56) switches to it in combat when its mana drops below 20
# percent (fixed, not tied to AiPlayerbot.LowMana), and goes back to Aspect of
# the Hawk once mana is at 60 percent or more (the 60 percent exit follows
# mod-playerbots); between the two it keeps the aspect it has, so it does not
# flip. An "aspect <name>" strategy a player set (hawk, monkey,
# cheetah, pack, beast, wild) is never overridden, and a hunter running in
# Cheetah or Pack is left alone. On by default; with 0 Viper stays a manual
# action and the hunter keeps Hawk.
# 0 - never switch to the Viper by itself
# 1 - Viper on low mana, Hawk again at 60 percent mana (Default)
AiPlayerbot.HunterViperOnLowMana = 1

# Paladin Judgement upkeep.
# In a group, paladin bots keep Judgement of Wisdom / Judgement of Light up on a
# boss or elite (or, inside a dungeon or raid, on the mob the tank is fighting),
# the way mod-playerbots does. A Retribution paladin owns
# Wisdom, a Holy paladin owns Light; with two paladins of the same kind the
# second one takes the other debuff, so two paladins never judge the same one,
# and a third paladin owns none. A paladin in the tank role (Protection) never
# owns a judgement; it keeps its own Seal. The owner swaps to the matching Seal and
# judges when the debuff has 4 seconds left or is gone (a Seal and a Judgement
# cost mana and a global each). A healing paladin only does this above 50% mana
# and never while someone in the party needs healing; everyone needs at least
# AiPlayerbot.MediumMana. Never solo, never on a target below 25% health. A
# debuff another paladin (a player) keeps up is left alone. On by default.
# 0 - paladins judge on their own rotation, no group debuff upkeep
# 1 - keep Judgement of Wisdom / Light up on the boss (Default)
AiPlayerbot.PaladinJudgementUpkeep = 1

# Onyxia whelps and eggs.
# In Onyxia's Lair, while Onyxia is airborne (phase 2), bots that are
# AoE-capable ranged DPS (mage, warlock, hunter, and ranged shaman and druid
# specs; never tanks or healers) take the nearest Onyxian Whelp as their target
# and keep it until it dies, then return to the boss. Every bot in the fight
# also steps back out of the egg caves west of the arena when it stands within
# 12 yd of an unbroken Onyxia Egg (the egg trap circle is 10 yd and hatches
# whelps). mod-playerbots parity, adapted to Turtle 1.18.1 entries. Only active
# on map 249 and only once the Onyxia fight strategy is on. An explicit target
# order from a player always wins. On by default.
# 0 - generic target choice and no egg avoidance
# 1 - whelp duty and egg avoidance (Default)
AiPlayerbot.OnyxiaWhelpsAndEggs = 1

# Work in progress. These features are not officially released and not supported yet. Enable them at your own risk.
# Until the official release, bug reports and feedback about them are not handled through the issue tracker; contact Hypeer directly.
# Dungeon boss tactics.
# Per-boss rows from the world table ai_boss_tactic (map + boss entry) that bots
# apply while they fight that boss: interrupt a listed spell, kill a listed add
# before anything else (in a listed order), stay out of the boss's front during a
# listed frontal attack. Built from Turtle's own core data; Uldaman up to
# Ironaya and the Obsidian Sentinel so far (docs/play/boss-tactics.md).
# On by default: every bot uses the tactics on a map that has rows.
# Bots of a bound group (a commander's or the run leader's) get the tactics regardless of
# this key. An explicit target order from a player always wins.
# 0 - off, except for commander-bound groups
# 1 - on for every bot on a map that has rows (Default)
AiPlayerbot.DungeonTactics = 1

# The "die together" boss tactic (ai_boss_tactic kind linked_death, docs/play/boss-tactics.md).
# A linked_death row lists one partner of a group (its boss_entry is the group's anchor) and a hold percent
# (param). While more than one member lives, the free DPS bots spread their damage to equalise the members'
# health: the pick is the living member with the highest health, and never one at or below param % while
# another stands above it. Once every living member is at or below param % the hold ends and the ordinary pick
# burns the lowest, so the group dies together. On Zul'Gurub's Thekal (14599 with the Zealots Lor'Khan 11347
# and Zath 11348) the row's 3 % is the point inside the 7 s in which a dead sibling is raised to full health.
# This is its own key on top of AiPlayerbot.DungeonTactics (or a commander-bound group) because it changes every
# free DPS bot's target pick. `.reload config` reads it again with the other AiPlayerbot.DungeonRun* keys.
# 0 - off: DPS bots pick as before (Default)
# 1 - on
AiPlayerbot.DungeonRunLinkedDeath = 0

# The aura tactics of the boss tactics rows (ai_boss_tactic, docs/play/boss-tactics.md): the dispel_priority,
# flee_on_aura, freeze_on_aura, dps_hold_after, taunt_after_cast and swap_on_aura kinds, and the shared row gates.
# A row can gate itself to a boss health band (hp_min/hp_max %) and to bots carrying an aura (bot_aura); only a row
# the fight scan reads can gate, so the loader skips a gate on hold_kill, tank_hold, one_at_a_time and linked_death.
# With this key off a gated row is closed and the six kinds are not read at all, so the table behaves exactly as
# before them. This is its own key on top of AiPlayerbot.DungeonTactics (or a commander-bound group) because the
# kinds change what every bot does mid-fight. `.reload config` reads it again with the other AiPlayerbot.DungeonRun*
# keys.
# 0 - off: no gate is honoured, the six aura kinds are ignored (Default)
# 1 - on
AiPlayerbot.DungeonRunAuraTactics = 0

# A needs_aura row names an entry and the aura a bot must carry: a bot without it never targets, attacks or taunts that unit, and the run guard sends nobody at it.
AiPlayerbot.DungeonRunAuraGatedTargets = 0

# Respawn nests: a unit that comes back within a minute and stands at its spawn point (Jin'do's Sacrificed Trolls) and hits nobody in the party does not hold a fight open, and a regroup never gathers on one. A unit that attacks the party is always a real fight and a guard target; the plan's own boss, hold and pull units are never a nest.
# 0 - off (Default)
# 1 - on
AiPlayerbot.DungeonRunRespawnNest = 0

# The kill_first candidates come from a grid search of the row's entries within 40 yd too, not only from each bot's attackers list (which "focus rti targets" collapses to the raid mark).
AiPlayerbot.DungeonRunKillFirstGrid = 0

# A kill-first focus on a totem is DPS-only, is issued before the run leader's guard, and the guard skips totems.
AiPlayerbot.DungeonRunTotemFocus = 0

# The use_object boss tactic of the boss tactics rows (ai_boss_tactic, docs/play/boss-tactics.md): one designated
# bot clicks the ready game object nearest the boss while the row's aura is up or its window has run out, and mode
# tank_anchor also walks the boss to the object first. With this key off the rows are ignored, so the table
# behaves exactly as before the kind. This is its own key on top of AiPlayerbot.DungeonTactics (or a
# commander-bound group) because the kind changes what a bot does mid-fight. `.reload config` reads it again with
# the other AiPlayerbot.DungeonRun* keys.
# 0 - off: use_object rows are ignored (Default)
# 1 - on
AiPlayerbot.DungeonRunUseObject = 0

# The swap_on_aura boss tactic of the boss tactics rows (ai_boss_tactic, docs/play/boss-tactics.md): at the row's stack
# count of its aura on the tank the boss is on, the next tank of the row's rotation that is alive, knows a taunt it
# can cast on the boss (Taunt, Growl or Hand of Reckoning; Taunt and Growl are melee-range) and carries fewer than
# half the row's threshold takes the boss off it. The swapped-off tank then holds for 20 s or until its own
# stacks are gone, whichever comes first: it stops attacking the boss, and every action aimed at that boss (any
# class's threat builder, melee swing or cast), all area damage and every taunt stay down, so it cannot take the boss
# back. The hold ends at once when the boss is no longer on the new tank (a resisted taunt, a dead new tank), so the
# old tank can rescue; an explicit player attack order on the boss also clears it. With this key off the rows are
# ignored, so the table behaves exactly as before the kind. Needs
# AiPlayerbot.DungeonRunAuraTactics as well (the row is one of the six aura kinds). This is its own key on top of
# AiPlayerbot.DungeonTactics (or a commander-bound group) because the kind changes what the tanks do mid-fight.
# `.reload config` reads it again with the other AiPlayerbot.DungeonRun* keys.
# 0 - off: swap_on_aura rows are ignored (Default)
# 1 - on
AiPlayerbot.DungeonRunTankSwap = 0

# A seek_aura row makes the raid gather in the cloud a dying source creature leaves; off ignores the rows.
AiPlayerbot.DungeonRunSeekAura = 0

# A pull_gate row makes the run leader refuse a boss pull while the boss wears the row's spell; off ignores the rows.
AiPlayerbot.DungeonRunPullGate = 0

# A bot charmed by a creature yields its AI to the charmer, and no area action lands on a charmed group member.
AiPlayerbot.DungeonRunCharmYield = 0

# A spread row widens the ranged raid's spacing while the boss fights; off ignores the rows.
AiPlayerbot.DungeonRunBossSpread = 0

# An avoid_cast row in mode `all` also clears the tanks: while its spell is cast no bot holds the caster, so every
# tank walks out of that blast too (the Zul'Gurub Bat Rider's self-destruct, where nothing is gained by staying).
# With the key off the row behaves like a default row (a tank the caster is on still holds it). This is its own
# key on top of AiPlayerbot.DungeonTactics (or a commander-bound group) because the mode changes what the tanks
# do mid-fight. `.reload config` reads it again with the other AiPlayerbot.DungeonRun* keys.
# 0 - off: `all` rows hold casters like default rows (Default)
# 1 - on
AiPlayerbot.DungeonRunAvoidCastAll = 0

# The burn_mana boss tactic of the boss tactics rows (ai_boss_tactic, docs/play/boss-tactics.md): while the row's
# boss stands at or above the row's start percent of mana, the first `priority` eligible bots (no tank, no healer, a
# priest with Mana Burn, a warlock with Drain Mana or a hunter with Viper Sting, ordered by guid; 0 means every
# eligible bot) keep draining it. Moam's Drain Mana refills him from the raid's casts, so the burners keep him below
# full mana and away from Arcane Eruption. With this key off the rows are ignored, so the table behaves exactly as
# before the kind. This is its own key on top of AiPlayerbot.DungeonTactics (or a commander-bound group).
# 0 - off: burn_mana rows are ignored (Default)
# 1 - on
AiPlayerbot.DungeonRunBurnMana = 0

# The ranged_only boss tactic of the boss tactics rows (ai_boss_tactic, docs/play/boss-tactics.md): a melee bot leaves
# the row's subject alone while it stands the row's gap (param, yards) or more above the bot, and takes the adds; a
# ranged bot is never held, and the hold ends by itself when the subject lands. With this key off the rows are
# ignored, so the table behaves exactly as before the kind. This is its own key on top of AiPlayerbot.DungeonTactics
# (or a commander-bound group).
# 0 - off: ranged_only rows are ignored (Default)
# 1 - on
AiPlayerbot.DungeonRunRangedOnly = 0

# Dungeon self-clear (the run leader).
# `.bot run start [plan]` lets a bound party clear a dungeon plan (world tables
# ai_dungeon_plan/leg/step) by itself: it walks the route, pulls the packs, kills
# the bosses and opens the doors, and pauses on 3 dead, on any player order and
# at every wait's ceiling. A player starts it for his own party (`.bot commander
# bind <LeadBot> [<Bot>...] inparty`, then `.bot run start`), and the bot LFG
# groups (AiPlayerbot.BotLfgGroups) start it for bot-only parties. Leading a
# party from outside it also needs AiPlayerbot.RemoteCommander = 1
# (docs/play/dungeon-run-leader.md).
# `.reload config` reads this key and the AiPlayerbot.DungeonRun* keys below again
# (only those; every other setting here needs a restart).
# 0 - `.bot run` is refused
# 1 - the run leader is on (Default)
AiPlayerbot.DungeonSelfClear = 1

# Raid bindings for the run leader: `.bot commander bind <LeadBot> raid` binds the commander's own raid of 6 to 40 bots (he leaves it; the lead bot is the main tank), and the run leader uses the raid rules (wipe level, gathering and rest scaled to the raid's size). Needs AiPlayerbot.DungeonSelfClear = 1 and AiPlayerbot.RemoteCommander = 1. Switching it off releases every raid binding.
# 0 - off (Default)
# 1 - on
AiPlayerbot.DungeonRunRaid = 0

# A raid binding's boss fight rules (only read with AiPlayerbot.DungeonRunRaid = 1): a boss fight (a boss step, or a plan boss engaged on any step) gets a 1200 s fight ceiling instead of 420 s, a member's death does not pause it while an engaged unit still loses hp (the raid's wipe level and the 1800 s hard cap still do), and the adds that hit the raid go to the living off-tanks in turn instead of drawing the main tank (the lead bot) off the boss; with the lead bot dead an off-tank takes the boss off a non-tank. With no off-tank alive the dungeon guard applies.
# 0 - off: a raid's boss fight keeps the dungeon rules (Default)
# 1 - on
AiPlayerbot.DungeonRunRaidBossRules = 0

# A raid binding's healer guard (only read with AiPlayerbot.DungeonRunRaid = 1): in a boss fight with AiPlayerbot.DungeonRunRaidBossRules = 1 whose main tank holds the boss, and in a trash fight whose main tank holds its current target, an add that attacks a healer goes to the raid's nearest ranged dps within 35 yd of it (up to two per add, nearest first) instead of the off-tanks; the off-tanks take such an add only when no ranged dps is free, and one holding the boss (or, in a trash fight, its own add) is never sent at another. An order refused by its bot counts for nothing (the next ranged dps is tried), and one the bot does not take up (its target is not the add) is over after 6 s: that bot is passed over for the add too. A further order waits 2 s, and the pick passes over a plan boss, an add the run holds (crowd control ordered or in place, or the fight's kill_first focus), a camp caster the tank would walk to, and an add that had two orders this fight until 20 s after its last one. A ranged dps busy with a commander task is not picked. Adds not on a healer are left to the dps. In a trash fight the main tank is never sent at a healer's add: with no ranged dps and no off-tank free for it, the add stays where it hits. The trash fight's guard needs no boss rules; without them the boss fight keeps the dungeon guard.
# 0 - off: the off-tanks take the adds, as before (Default)
# 1 - on
AiPlayerbot.DungeonRunRaidHealerGuard = 0

# A raid binding's healer seats (.bot commander bind <LeadBot> raid, only read with AiPlayerbot.DungeonRunRaid = 1):
# with 1 the seats go by class instead of member order. The raid seats take a group healer first (priest, then druid,
# then shaman, then any other healer); the raid keeps at least a third of its healers, rounded up, and the tanks take
# the rest up to two each. The main-tank seats then take the next healers (any class, one the raid seats do not hold
# back first, so a paladin lands on a tank), and the off-tank seats take whoever is left. A healer a mid-raid hire
# joined a tank as is seated by the joiner rule, not this layout. A raid already bound keeps its seats until it is
# bound again.
# 0 - off: seats by member order (Default)
# 1 - on
AiPlayerbot.RaidHealerSeatsByClass = 0

# A tank healer a raid binding's layout seated helps the raid while its tank has nothing to heal (only read with
# AiPlayerbot.DungeonRunRaid = 1). Only the tank's second (or later) seat may leave, so the tank keeps its first
# healer, and only while the tank is found, alive, not fighting a boss, and at or above 90% health after the damage
# it is taking. The healer then treats a group member below 70% that is in sight and inside heal range; it never
# walks into sight for one. A player-set focus list outside the layout, a mid-raid joiner, and a layout healer
# whose focus list a player edited (anything added or dropped) do not get it.
# .reload config applies it at once.
# 0 - off: the tank healers keep their focus targets (Default)
# 1 - on
AiPlayerbot.RaidTankHealerAssist = 0

# Opt-in "fankriss tank" role (.bot strategy +fankriss tank): an assigned tank with no Mortal Wound
# stacks taunts Fankriss off the current tank at this many stacks (1-9, clamped). Does not enable the role.
AiPlayerbot.FankrissSwapStacks = 5

# Opt-in Patchwerk roles (.bot strategy +patchwerk main TankName): once the assigned main engages
# Patchwerk, DPS hold their damage for this many seconds (they also wait during the ordered approach).
# 0 turns the hold off; any other value is clamped to 3-5. Does not enable the roles.
AiPlayerbot.PatchwerkOpeningDelay = 4

# Bot LFG dungeon groups: online, idle world bots of one faction and of a proven
# dungeon's level band (table ai_bot_lfg_plan; the band is the LFT addon's) form a
# group of four, tank, healer and damage, with one role left open for a player.
# While it waits it looks for that player in the LookingForGroup channel (AiPlayerbot.BotLfgChat).
# When no player joins within AiPlayerbot.BotLfgFillAfterMinutes, a bot of the open
# role joins. Getting the group to the dungeon is not built yet, so a full group
# breaks up again after two minutes. A GameMaster watches and drives them with
# `.bot run lfg list | form [plan] | fill <id> | disband <id>`; `.bot run system`
# runs a bot-only party through a dungeon by hand.
# Needs AiPlayerbot.DungeonSelfClear = 1 (with it off the server log says the
# feature stays dormant). Does not need AiPlayerbot.RemoteCommander.
# `.reload config` reads this key again.
# 0 - off (Default)
# 1 - on
AiPlayerbot.BotLfgGroups = 0

# Bot LFG groups: how long a group of four waits for a player before a bot takes
# the open slot (minutes, 1-60). Only read while AiPlayerbot.BotLfgGroups = 1.
# `.reload config` reads it again.
# Default: 10
AiPlayerbot.BotLfgFillAfterMinutes = 10

# Bot LFG groups: how many groups exist at once per 100 bots online (0-20; 0 forms none by itself, a GameMaster still can). Only read while AiPlayerbot.BotLfgGroups = 1.
# `.reload config` reads it again.
# Default: 1
AiPlayerbot.BotLfgGroupsPer100Bots = 1

# Bot LFG groups: the most groups at once (0-20). Only read while AiPlayerbot.BotLfgGroups = 1.
# `.reload config` reads it again.
# Default: 5
AiPlayerbot.BotLfgMaxGroups = 5

# Bot LFG groups: groups form only while at least one real player is online. Only read while AiPlayerbot.BotLfgGroups = 1.
# `.reload config` reads it again.
# 0 - also on an empty server
# 1 - only with a player online (Default)
AiPlayerbot.BotLfgOnlyWithPlayersOnline = 1

# Bot LFG groups: the leader of a group that waits for a player posts one line in
# its faction's LookingForGroup channel (the dungeon, the open role, the level
# band, "w me inv"), again every 3 minutes, never more than one post per 30 s per
# faction across all groups, and only while a real player of that faction is
# online. A real player who whispers the leader "inv" gets a party invite when his
# faction, level and class fit the open role; other whispers get one short answer.
# Only read while AiPlayerbot.BotLfgGroups = 1. `.reload config` reads it again.
# 0 - off
# 1 - on (Default)
AiPlayerbot.BotLfgChat = 1

# The run leader's walk back after a guarded fight. When the tank left its stand
# to take mobs off the party, the run used to walk the tank and the party back to
# that stand after every fight, then forward again to the next pack or boss.
# 0 - once the step's pack is cleared (or on a move step) the run goes on from
#     where the tank stands; a pack with units left is still pulled from the
#     stand, so the tank goes back to it first (Default)
# 1 - walk back to the stand after every guarded fight, as before 2026-10-22
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunWalkBackAfterWonFight = 0

# The run leader's retreat at two dead. In a fight with two members dead, the lead
# bot alive and no engaged unit losing hp for 15 s, the living walk back to the
# run's last stand (at most 40 yd away) once, for at most 20 s, before a third
# death makes it a wipe. Never in a scripted event or against an event boss.
# 0 - off: the party fights on as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunRetreatAt2Dead = 0

# The run leader's rescue of a stuck walk back. A walk back whose lead bot is stuck
# short of its point after its tries, and a placed run's lead bot revived behind
# the run's start step, are teleported to a safe point on the run's way (out of
# every live pack's reach), out of combat, once a step.
# 0 - off: the stuck walk back pauses as before
# 1 - on (Default)
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunWalkBackRescue = 1

# The run leader's dry walk. A walk whose own way would swim after leaving the
# lead bot's own water goes in dry legs first (at most 24 a walk), and the
# approach hops and firing stand it picks come from a ground-only navmesh path
# instead of one over the water's surface. The walk-back shortcut is not
# re-pathed: its straight swim chord is refused, so the walk back replays the
# plan's points (the leg-on-path read and the too-far legs are unchanged). A
# point in deep water, and a dry way more than 3 times the way the run would
# walk, keep the old behaviour, so intended swims still work: a wet firing
# stand of a pack in the water, a straggler standing in water, and a walk point
# in water are as before. A dry straggler whose way would swim has no path that
# ends at the point: its pull moves to the next tank and can pause the run.
# This changes routes on every walk whose path crosses deep water.
# 0 - off: the run leader walks the core's own path, water included (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunDryWalk = 0

# The run leader's teleport return. A party bot the run brings back from farther
# than this many yards from the lead bot (revived far away, left behind after the
# lead bot's rescue teleport, wedged on another floor, or a summon the portal
# dropped because the bot was fighting) has its combat dropped and is teleported
# to the lead bot at once, in a fight or not, instead of the 3 s summon portal or
# a walk back through the packs. If the lead bot stands in the reach of a pack
# not pulled yet, the bot lands beside it outside that reach. Three tries 5 s
# apart, then the run's note names the bot. Parties with no real player only.
# 0 - off (the shipped default): the summon portal, and a walk back when it fails, as before
# Recommended 120.
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.RunTeleportReturnYd = 0

# The run leader's hold for bots waiting to be brought back. A run's bot revived
# in a dungeon farther than this many yards from the lead bot (any revive: the
# run's, a player's, a GameMaster's, with the run paused too) stands still for up
# to 60 s for a summon or teleport, and so does every bot the run is summoning
# or teleporting back, until it is within 10 yd of where it is brought: no
# follow, no walking, no chasing; it fights back only from where it stands.
# 0 - off (the shipped default)
# Recommended 100.
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonReviveHoldYd = 0

# The run leader's fight forward. After a won fight, the next pack within 30 yd
# of the tank is pulled from where the tank stands instead of walking the plan's
# rows back to its stand, when the navmesh path to it is direct, the tank sees it
# and no live hostile stands by the way.
# 0 - off: the plan's rows as before
# 1 - on (Default)
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunFightForward = 1

# The run leader's light rest lines. Before a small pull (or with no fight ahead)
# the party rests only under 60 % health / 35 % healer mana / 25 % mana and to
# 75 / 60 / 45; before a boss, an event or a big pull the full lines stay.
# 0 - off: the full lines everywhere, as before
# 1 - on (Default)
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunLightRest = 1

# The run leader's time limit, in minutes from `.bot run start` (a pause counts).
# At the limit the run ends and its status line says "time limit reached (3h)".
# 0 - no limit
# 180 - three hours (Default)
AiPlayerbot.DungeonRunMaxMinutes = 180

# The run leader's pull aggro estimate. Before each pack pull it works out how many
# other creatures the pull would bring (the pack, creatures in aggro range of the
# party, one ring of family assistance from every member of the pulled pack, at
# least 20 yd wide) and, when that is more than the ceiling below, rests the party
# to its end lines once before it pulls (status note "N joiners expected"). It adds
# no movement and never skips a pull.
# 0 - off, the run leader pulls as before (Default)
# 1 - on
AiPlayerbot.DungeonRunAggroEstimate = 0

# Joiners (creatures besides the pulled one) above which the estimate rests the party first.
# 6 - default; 1 and up. Only read while AiPlayerbot.DungeonRunAggroEstimate = 1.
AiPlayerbot.DungeonRunAggroCeiling = 6

# The ring estimate: instead of counting only from where the party stands, the estimate also
# counts every creature the walk to the pull, the stand and the fight point would wake, and
# every creature within the ring below of one already counted (a call for help carries: two
# hops). The count is compared with a pull row's own ceiling (a plan's max_bodies, the target
# included), else with DungeonRunAggroCeiling + 1. A pull over its ceiling rests once and notes
# "pull estimate: N bodies over the ceiling M"; the last approach row also notes once how many
# the coming pull would bring ("ahead: pull N brings ..."). Advice only: no order changes.
# 0 - off, the estimate as before (Default)
# 1 - on; only read while AiPlayerbot.DungeonRunAggroEstimate = 1
AiPlayerbot.DungeonRunAggroWalkRing = 0

# How far a call for help carries in the ring estimate, in yards (the measured wakes were
# 11.0-19.5 yd; the server's own CreatureFamilyAssistanceRadius is 10). The larger of the two
# is used.
# 20 - default; 5 to 40
AiPlayerbot.DungeonRunAggroRingYd = 20

# The run leader's pack-cleared gate. A `pull` step is done only when nothing of its
# entries is left: no living unit in its radius, no unit in the band around it
# (radius + this many yards on the ground, 10 yd of height), no patroller, and no
# unit that spawned inside its radius still walking its loop. A unit left in the band
# is pulled (nearest first), up to DungeonRunPackClearRepulls times; then the run pauses
# with the units' entries, guids and distances so a human can clear it.
# 10 - the band, in yards (Default); 0 - off, today's radius-only rule
# 30 - the most (a patrol is read 30 yd beyond the radius)
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunPackClearMarginYd = 10

# How many residue pulls a pull step may send before it pauses for a human.
# 3 - default; 1 to 10. Only read while AiPlayerbot.DungeonRunPackClearMarginYd is above 0.
AiPlayerbot.DungeonRunPackClearRepulls = 3

# The run leader pulls a straggler itself instead of pausing. A unit the step waits
# for that did not come -- a unit of the pack that spawned in the step's radius and
# walked its loop away, or a patrol a stand-pull row waits for at its stand -- is
# walked to and pulled by the tank: the lead bot while it lives and is a tank, else
# the off-tank holding the main tank role. The tank walks to the unit (a patrol: to
# the nearest point of its loop on the party's side) and attacks it, the rest of the
# party staying where it stands. Each try has 45 s; a failed try by the lead bot
# goes to the off-tank once; only then does the run pause as before. The pull is
# skipped, and the run pauses as before with the reason in the line, when another
# pack not pulled yet would be woken on the way there (the way passes within its
# aggro reach plus 5 yd of it) or when no path reaches the point. A patrol a
# stand-pull row waits for is waited for one full loop of its own path at most (90 s
# when that cannot be read) instead of the row's 600 s before the tank goes.
# A boss, a kill_first unit and a linked_death unit keep the old behaviour.
# 0 - off, the run pauses as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunStragglerPull = 0

# The run leader's near-wipe stop: this many wipe events (a near wipe, a wipe, the
# revive after either) within the window below pause the run once the fight is over,
# instead of regrouping and walking into the same cost again. A resume starts a
# fresh count.
# 2 - default; 0 - off; 1 to 10
# Only a raid binding (`AiPlayerbot.DungeonRunRaid = 1`) gets it by default.
AiPlayerbot.DungeonRunNearWipeStop = 2

# The near-wipe stop's window, in minutes of running time (a pause does not age it).
# 10 - default; 1 to 60. Only read while AiPlayerbot.DungeonRunNearWipeStop is above 0.
AiPlayerbot.DungeonRunNearWipeStopMinutes = 10

# 1 - a party binding gets the near-wipe stop too; 0 - raids only (Default).
# Parties regroup by themselves as their designed recovery.
AiPlayerbot.DungeonRunNearWipeStopParty = 0

# The run leader's regroup after a death: how long it waits for a living priest,
# paladin or shaman (a druid's Rebirth only when none of those lives) to raise the
# fallen where they lie before `cmd revive party` sends them to the spirit healer.
# 0 - a fixed 15 s wait when a priest, paladin or shaman is out of combat (Default)
# 1 - the rez hold: up to 60 s (more for each extra body), a resurrector short of
#     mana is waited for up to 90 s, bodies over 80 yd away are not waited for
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunRezHold = 0

# The run leader's pull stand. A `pullback` goes out only when the tank can shoot
# from where it stands: the target in its sight, within its ranged pull's range
# less 5 yd, and the tank standing still (it is waited for up to 3 s). Otherwise
# the party walks to a firing stand on the tank's navmesh path to the target
# first (at most 2 stands per target and step), then the order goes out; a stand
# walk that gets stuck gives the stand up, it never pauses the run. Only a pull with
# a ranged weapon (bow, crossbow, gun, thrown, wand) is covered: a spell pull or a
# body pull (no ranged weapon, skill or ammo) goes out as before.
# The status note of each order names the target's guid and how its shot stood.
# 0 - off, the run leader pulls as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunPullStand = 0

# The pull stand keeps clear of other packs. It applies to every firing stand the run leader picks: an authored
# stand-pull step's (always) and a generic stand pull's (with AiPlayerbot.DungeonRunPullStand = 1). Every firing
# stand the tank's path to the target offers is checked, in the same order as before, and the first one that is far enough
# from every other living pack is taken. Far enough is the pack's aggro reach (its detection range minus the
# party's level advantage over it) plus 4 yd: the bots stand at the stand point, and only the unit's reach and the
# line of sight the core needs decide whether it can wake on the stand. A pack that patrols is checked along its
# whole loop, so a stand the loop will walk past is refused too. A creature the pulled pack's call for help reaches
# (the core's 10 yd family assistance radius, one call out) is part of the pulled pack. The stand must also stay the
# pulled pack's widest aggro reach away from every unit of it, so the party does not wake it on the way. On a boss
# step the boss's own fight is no other pack: the units the plan lists for the step, the creatures the core links to
# the boss and the ones already in the fight never refuse a stand. A unit more than 8 yd above or below the stand
# with no line of sight to it stands on another storey and never refuses one either.
# The clearance is advisory: with every stand refused, the tank uses the stand the key is off for (the path's first
# in range) and the note reads
# "stand_pull: no clear stand for <entry> (closest <entry> at <yd>); using the default stand". Only a patrolling
# pack that blocks the stand alone is waited for, up to 20 s, to walk clear; then the run goes on.
# 0 - off, the stand is picked as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunStandClearance = 0

# The crowd control before the walk in. On a stand-pull step (the plan marks its pull row or boss row stand_pull, with
# a move row right before it), the run leader walks the party to the plan's approach and pulls from there; that walk
# can pass inside the pulled pack's own aggro range, and the pack then wakes before the step's Polymorph, Shackle or
# Sap goes out. With this key the move row before the pull ends at the last point of its walk that stands outside the
# pack's own wake reach (the widest aggro reach of the pack's living units plus the party's 10 yd spread plus 1 yd),
# the step's crowd control goes out there, and only then the party walks to the plan's approach and pulls. When no
# point of the walk is that clear (an approach inside the pack by design) the row walks the plan's point as before,
# and the note reads "stand_pull: no pre-cc point for <entry>". The row waits up to 3 s for the point to be read,
# then goes on without it: a read that does not come never holds the run. A stand-pull step whose approach is already
# clear is unchanged, and so is every other step.
# 0 - off, the walk in is exactly as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunStandPullPreCc = 0

# The plan's stand is the only stand a pull row uses. With this key the run leader
# never searches a closer firing stand when the plan's authored approach cannot see
# the pulled unit: it walks the tank back to that approach and holds there for up to
# 20 s per unit (status note "no LOS from the authored stand; holding"), then searches a
# firing stand as with 0 (note "no LOS from the authored stand after 20 s; searching a
# firing stand"). It needs no AiPlayerbot.DungeonRunPullStand. Before the row fires it also
# waits for every living tank and melee to stand at that approach (within 5 yd) or
# clear of the next pull's pack (farther than its radius plus the core's 20 yd aggro
# ring from its point): up to 10 s, then the row fires and its note names those still
# out of place. A hop pull and a walk-back pull never wait.
# 0 - off, a stand the path offers is searched as before and the row fires as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunStandDiscipline = 0

# Automatic crowd control: the run leader marks crowd control on a pack from what the raid
# actually has, not only the plan's cc_priority/cc_always entries. Before a pull that brings
# more than DungeonRunAutoCcAbove bodies it marks the pack's best targets (casters and healers
# first, then the plan's rank, then the class families Polymorph, Shackle, Banish, Hibernate,
# Seduction, Freezing Trap, Sap, Repentance) until the unmarked bodies fit the threshold; in
# the fight it marks a joiner while more than the threshold of unheld units fight it, and it
# re-sends a crowd control that broke (twice a unit a step). The pack's own units are the only
# pre-pull candidates; a tank, the lead bot, a healer while fewer than 4 healers (1 in a party)
# would stay free, and the unit the tank or an off-tank holds are never marked. A non-elite
# (NORMAL-rank) unit is no body of either pack count that starts a mark, before the pull or in
# the fight, and it is never marked unless the plan lists it in cc_priority/cc_always; a plan's
# cc_never list excludes its entries from the automatic marks entirely (a cc_never unit still
# counts as a body: a unit that cannot be held is dangerous all the same). With the key on
# the run uses seven marks (moon, square, diamond, triangle, star, circle, cross; skull stays
# the fight's focus); a player's icon is never moved.
# 0 - off, the plan's cc list only, as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunAutoCc = 0

# How many bodies a pull may bring before the automatic crowd control starts (CC starts above
# it), and the ceiling a plan row's own max_bodies still lowers.
# 6 - default (CC from 7 bodies); 2 to 40. Only read while AiPlayerbot.DungeonRunAutoCc = 1.
AiPlayerbot.DungeonRunAutoCcAbove = 6

# The risky crowd control families (Fear, Scare Beast): the mob runs. Only with 35 yd of room
# to the nearest creature outside its pack, and only when no other family has a free bot.
# 0 - off (Default); 1 - on. Only read while AiPlayerbot.DungeonRunAutoCc = 1.
AiPlayerbot.DungeonRunAutoCcRisky = 0

# The run leader's loot step when the corpse's item is another member's under the group's loot
# rules (round robin / group loot: the loot step is refused with "nothing this bot may loot",
# e.g. Uldaman, Revelosh's Shaft of Tsol). With 1 the lead bot (it leads the bound group) sets
# the loot method to free-for-all, the carrier loots the item, and the method goes back to
# what it was; it also goes back when the run pauses or stops in between. Once per step. If the
# lead bot does not lead the group or the order is refused, the step goes on as before (the
# next bot is tried).
# 0 - off, the run leader tries the other bots in turn as before (Default)
# 1 - on
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunLootFfa = 0

# Player-led runs (owner 2026-10-23). A player who leads his own party of bots
# (up to three other players may be in it) starts `.bot run start [plan] player
# [tank <Bot>]`: he walks wherever he wants, and the run leader pulls the plan's
# packs near him with the tank bot, marks, crowd controls, rests and revives.
# Plain `.bot run start` stays bot-led. Needs AiPlayerbot.DungeonSelfClear = 1.
# 0 - `.bot run start ... player` is refused
# 1 - a player who leads his party may start a player-led run (Default)
AiPlayerbot.DungeonRunPlayerLed = 1

# How close (yards, straight line) the leading player must stand to a plan pack
# or boss for the player-led run to pull it.
# 40 - default; 5 to 100. Only read while AiPlayerbot.DungeonRunPlayerLed = 1.
AiPlayerbot.DungeonRunPlayerLedPullYd = 40

# How long (minutes) the leading player of a player-led run may be out of the
# plan's dungeon. Meanwhile the bots that stayed inside hold where they stand;
# back in time, they follow him again and the run goes on. Past it the run
# stops with a note and its binding ends (the bots keep holding).
# 10 - default; 1 to 60. Only read while AiPlayerbot.DungeonRunPlayerLed = 1.
AiPlayerbot.DungeonRunPlayerLedAwayMinutes = 10

# Bot-only runs only: the run leader GIVES each needed dungeon item/key (the plan's
# ai_dungeon_leg_need rows) to every bot of the party at the start, and TAKES it back
# at the end, on stop, when a bot leaves, or when a real player joins. The warn/hold/skip
# check (a key door warns and holds, a blocking item asks, an optional leg skips) is always on.
# 1 - give the items to the bots (Default)
# 0 - give nothing (blocking items refuse the start of a bot-only run instead)
# Only read while AiPlayerbot.DungeonSelfClear = 1.
AiPlayerbot.DungeonRunGiveItems = 1

# When 1, bots also carry the needed dungeon keys/items in a party WITH real players and open
# the doors for them (players skip the key content); 0 = players must bring their own key,
# the bots stop at the door and ask. Only read while AiPlayerbot.DungeonSelfClear = 1.
# 0 - players bring their own key, the bots stop at the door and ask (Default)
# 1 - bots carry the keys and open the doors
AiPlayerbot.DungeonRunBotKeysForPlayers = 0

# Scripted area triggers for bots (an audited allowlist of trigger ids, off by default).
# A bot has no game client, so it never tells the server it walked into an area
# trigger, and a trigger script never ran for it: Zul'Farrak's Witch Doctor
# Zum'rah, who only turns hostile through such a script, stayed friendly in
# front of an all-bot party. A living bot in a group inside a dungeon (not a
# raid) now runs the script of a listed trigger it walks into, once per entry,
# as a player's client would - but only when its party is clearing on purpose:
# bound to a remote commander (every run-leader run is), or with a human member
# within 40 yd. A follower running ahead of its player cannot start an event
# alone. Instance entrances and exits, taverns and battleground entrances never
# fire, listed or not. Each bot checks its own map's listed triggers twice a
# second (no world scan).
# Not every trigger script is safe to start from a bot (at_ring_of_law starts
# the Blackrock Depths arena, the UBRS stadium trigger starts that event,
# at_shadowforge_bridge spawns guards), so read and document a trigger's script
# in docs/server/settings/dungeons-raids.md before adding its id here.
# Audited ids (set the key to these to opt in):
#   962 - Zul'Farrak, at_zumrah: if Witch Doctor Zum'rah is alive within 30 yd,
#         he turns hostile, yells, and his encounter is marked in progress
#         (nothing else). Opt in with: AiPlayerbot.BotAreaTriggers = 962
# Since fix/plan-gossip-allow a dungeon run did not need this list for its own
# plan: a move or move_direct step whose `entry` names a trigger armed it for the
# run's bots from that step on until it fired once for the run (Zul'Farrak's walk
# into 962), and no other unlisted trigger. A refused script (at_zumrah with
# Zum'rah farther than 30 yd) kept it armed and was tried again every 2 s while
# the bot stood inside. A run started past that move step never armed it: when
# the event had not happened, the run was started again from before the step.
# Comma-separated trigger ids; empty (the default) turns the feature off.
# New automation, so it is off by default.
# Default: (empty)
AiPlayerbot.BotAreaTriggers =

# Keep out of creature auras.
# Some creatures carry a permanent damaging aura that pulses around them even
# while they are idle. With this on, every bot steps out when it is within 8 yd
# (10 yd for Living Poison) of a listed creature (from its centre), its chase
# and other moves keep 9 yd (11 yd) away, and a follower stops just outside that circle while its leader stands
# in it; the ranged kill it. A melee DPS bot holding outside the circle on its
# target switches target after 3 s and leaves that target alone for 30 s,
# also when the tank fights it or it carries the bot's raid mark. Tanks are
# exempt in combat from the sludge (they may hold mobs inside), not from
# Living Poison. The creature the player
# ordered the bot to attack is never avoided by that bot. Listed today:
# Maraudon's Creeping Sludge (12222, aura 22638 Poison Shock, 5 yd every 2 s)
# and Naxxramas' Living Poison (16027, no aura, not selectable, Explode 28433
# within 5 yd, about 30k: tanks get no pass; bots keep out to 10 yd, paths to
# 11 yd).
# With it on, a non-tank bot without an attack order also does not Charge,
# Intercept or Feral Charge onto a listed creature or onto a mob within 9 yd
# of one, and its flank, set-behind and unstack moves never end in the ring.
# On by default.
# 0 - no keep-out; bots melee and walk past these creatures as before
# 1 - stay out of listed creature auras (Default)
AiPlayerbot.AvoidCreatureAuras = 1

# Two taxi paths in the 1.18.1 client data have missing nodes, and a bot that
# flies one crashes the world server: 355 (Shimmerstar Lake -> Valormok) and
# 274 (an unused dev path). Bots never take them unless this is on.
# Turn it on ONLY with a core that repairs them at startup (drops 274, rebuilds
# 355 from its reverse path 356); the server log then shows "Taxi path 355 ...
# rebuilt from reverse path 356". On a core without that repair it crashes.
# 0 - bots skip the broken taxi paths (Default)
# 1 - bots may fly the repaired paths (needs the core repair)
AiPlayerbot.AllowRepairedTaxiPaths = 0

# Test shortcut, off by default. A bot that boards a taxi arrives at the
# destination flight-master node at once instead of flying the route, so
# travel-heavy tests do not wait on flight time. Real players always fly.
# 0 - bots fly the route (Default)
# 1 - boarded bots land at the destination node right away
AiPlayerbot.BotInstantFlight = 0

# Bots and npcs turn to eachother during an rpg interaction
AiPlayerbot.TurnInRpg = 0

# Bots will make sounds when repairing, selling items ect.
AiPlayerbot.GlobalSoundEffects = 0

# Show progress bars for random bots (enabled by default)
AiPlayerbot.ShowProgressBars = 1

# Set randombots movement speed to walking anywhere
AiPlayerbot.RandombotsWalkingRPG = 0

# Bots greet real players passing by (text emote, once per encounter).
# Bots never greet other bots: the pool is hundreds of them, so greetings only
# make sense for a real player audience. 0 disables greetings entirely.
AiPlayerbot.EnableGreet = 1

# Seconds before the same real player is greeted again by the same bot.
# A player who keeps walking in and out of sight is greeted once per window.
AiPlayerbot.GreetCooldown = 600

# Masterless pool bots also greet real players (1), or only greet for a live
# player master (0, default). With hundreds of pool bots in one zone the wave
# of greetings answers every visitor, so it is opt-in.
AiPlayerbot.RandomBotGreet = 0

# Pool bots buff (and sometimes heal) real players they pass in the world.
# A passing priest casts Power Word: Fortitude, a druid Mark of the Wild, a
# mage Arcane Intellect (mana users only), a paladin one Blessing fitting the
# player's class; a passing priest/druid lands Renew/Rejuvenation on a player
# below 35% health. Only instant casts on the move, the bot never stops or
# leaves its travel. 0 disables the sweeps entirely.
AiPlayerbot.PassingBuffs = 1

# Chance (0-1) that a bot in combat plays an attack emote
#AiPlayerbot.AttackEmoteChance = 0.0

# Pool bots share their attack targets with each other instead of each picking
# their own
#AiPlayerbot.ShareTargets = 1

# Pool bots wear their helmet and cloak (1, default); 0 = they show up
# bare-headed and bare-backed. Pool bots get the setting on their next login;
# hired companions and a player's own characters keep their own setting.
AiPlayerbot.RandomBotShowHelmet = 1
AiPlayerbot.RandomBotShowCloak = 1

# Random starting level for freshly created pool bots, inclusive range.
# Applied once per bot on its first login (played time == 0), before the
# level-bound skills, professions and starter gear are seeded, so a fresh pool
# starts playable instead of walking up from level 1. Bots level up normally
# from there. 1/1 keeps the historic behaviour (start at level 1).
# The minimum defaults to 5: gear seeding starts at level 5, and a bot that
# rolls 1-4 keeps its level-1 outfit for good (its played time is no longer 0
# when it reaches level 5), so the default never rolls below 5.
# Default: 5 / 60 (fresh bots spread over levels 5-60)
AiPlayerbot.RandomBotStartLevelMin = 5
AiPlayerbot.RandomBotStartLevelMax = 60

# Set XP rate for bots (default: 1)
# Server XP Rate * AiPlayerbot.XPRate
AiPlayerbot.XPRate = 3

# Set minimum level of randombots where gets enchants on items (Maxlevel + 1 to disable)
# Default: 10
AiPlayerbot.minEnchantingBotLevel = 10

# Randombots checking players gear score level and deny the group invite if it's too low
# Default: 0 (disabled)
AiPlayerbot.GearScoreCheck = 0

# Randombots checking players level difference and deny the group invite if it's too low
# Default: 30
AiPlayerbot.LevelCheck = 30

# Spells that won't affect bots
AiPlayerbot.ImmuneSpellIds = 19428

# Randombots will invite players to groups/raids/guilds. (This can also be disabled by turning on DnD on your character)
# AiPlayerbot.RandomBotInvitePlayer = 1

# Randombots will invite nearby bots to groups/raids/guilds. Off by default
# (mod-playerbots parity): bot-only groups leash members and stall the pool.
# AiPlayerbot.RandomBotGroupNearby = 0
# AiPlayerbot.RandomBotRaidNearby = 1
# AiPlayerbot.RandomBotGuildNearby = 1

# Bots founding their own guilds is off by default. Turn on to let eligible pool bots buy a charter, gather signatures and found a guild.
AiPlayerbot.RandomBotFormGuild = 0

# Enable per-bot action log files (logs/bots/<botname>_acc<id>_<timestamp>.log)
# and "[BOT]" prefixed structured log lines in the server log. Useful for
# diagnosing bot lifecycle issues; on by default, limited by ActionLogScope. The crash handler also
# reads a thread-local "last phase" tag set by SC_PHASE when this is on.
# AiPlayerbot.EnableActionLog = 1

# Safeguards for the per-bot action log files (they once filled a disk: about
# 8 GB a day, up to 176 MB for one bot). They apply only while EnableActionLog
# is 1, except the cleanup, which also trims files an earlier run left behind.
#
# Which bots get a file:
#   all        every bot, pool bots included (100+ files on a busy realm)
#   commanded  only bots in a group a commander bound (.bot commander bind)
#              and hired companions
#   none       no files
# A bot's answer is cached and looked up again every 15 seconds, so a bot that
# was just bound or hired starts logging within that time.
AiPlayerbot.ActionLogScope = commanded

# Cleanup of logs/bots: at startup and then every hour (and early once the bots
# wrote a quarter of the size limit since the last one) the oldest files are
# deleted until both limits hold. Only files named like the ones this log
# writes (<bot>_acc<id>_<date>-<time>.log) are ever listed or deleted, never a
# link, a folder or any other file. A file a bot has open is never deleted. One
# summary line is written to the server log per cleanup. 0 turns a limit off.
AiPlayerbot.ActionLogMaxAgeDays = 3
AiPlayerbot.ActionLogMaxTotalMB = 2048

# One bot's file is closed with a note when it would pass this size, and the log
# goes on in a new file (the cleanup above removes the old ones). 0 = no cap.
AiPlayerbot.ActionLogMaxFileMB = 100

# Aggregate counter of executed bot actions for live measurement on large
# realms: every 5 minutes a cumulative snapshot (utc_time,class,action,
# ok_count,fail_count) is appended to logs/action_counts.csv. Off in
# production; turn on for a measurement window, then diff two snapshots with
# tools/action_counts_report.py to see the top actions per class.
AiPlayerbot.ActionCountsLog = 0
# Low-volume grouped-healer snapshots and failed heal checks in bot_events.csv.
# Requires bot_events.csv in AllowedLogFiles. At most one event of each kind
# per healer per 10 seconds; does not change AI decisions or enable action logs.
AiPlayerbot.HealerDiagnostics = 0

# Redirect all bot subsystem log output to a dedicated file so the main
# server.log stays clean. Path is relative to the server's LogsDir setting.
#
# Off by default, and that is deliberate. With a file set, BotLog writes and
# flushes every line it is handed, and BotLog::outDetail has no level gate at
# all - unlike outDebug, which honours BotLogDebug below. BotLog also reports
# HasLogLevelOrHigher() as always true, so level checks in bot code do not
# apply either. On a busy server the file reaches tens of gigabytes overnight;
# the loudest single writer is ahbot/ItemBag.cpp, one line per item that fits
# no category, on every auction house pass.
#
# Left empty, bot output falls through to the core logger, where LogFileLevel
# applies and DETAIL is dropped at level 1. Set a filename only while actually
# diagnosing something, and watch its size.
AiPlayerbot.BotLogFile =

# Write DEBUG-level messages to the bot log. Disabled by default. Note that
# this gate only covers outDebug; outString, outInfo, outDetail, outError,
# outBasic and outErrorDb are written regardless whenever BotLogFile is set.
# AiPlayerbot.BotLogDebug = 0

# The in-chat "summon" order teleports the bot straight to a non-GM player; otherwise
# the bot walks or uses a meeting stone or innkeeper. .bot summon is not affected.
# AiPlayerbot.NonGmFreeSummon = 0

# Bots may also use the innkeeper "summon me" path when resolving a summon order
#AiPlayerbot.SummonAtInnkeepersEnabled = 1

# Bots write their spec, talents and both primary professions with skill into
# their guild public note (e.g. "Arms 31/20/0 Mi245 BS230"), refreshed on
# talent changes and every few minutes on skill changes. No guild rank right
# needed; bots never read or write officer notes for this.
# AiPlayerbot.TalentsInPublicNote = 1

# Pool bots get profession skill of level x 5 and every trainer recipe they
# qualify for. Off: bots still get their profession pair at level 5, but only
# as the real rank-1 Apprentice of each (skill 1, no automatic recipes);
# further ranks and recipes come only from trainer visits, skill from gathering
# and crafting. Switching it changes nothing for existing bots. Use at your own
# risk: bots levelling a profession from 1 to 300 on their own has not been tested.
# AiPlayerbot.ProfessionsGrowWithLevel = 1

# Pool bots with a profession at the specialization gate earn its specialization
# spells directly (Engineering Goblin/Gnomish at 200, Blacksmithing Armorsmith/
# Weaponsmith plus Axe/Hammer/Swordsmith at 200, Leatherworking Dragonscale/
# Elemental/Tribal at 225, Turtle Jewelcrafting Gemology/Goldsmith at 225):
# the quest chains players use are exclusive per branch, but bots never run
# them, and the core enforces nothing between branches, so all branches
# together are safe. Their spec-gated recipes land the same way (gated by the
# matching spec spell). Only pool bots; real players are never touched.
# 0 off, 1 one branch per bot (even/odd guid, never flips), 2 all branches.
AiPlayerbot.BotProfessionSpecializations = 2

#max limit of members in a guild (bots will leave guild if there are more members than this number)
# AiPlayerbot.GuildMaxBotLimit = 1000

# Minimum level at which bots will start accepting duels
# AiPlayerbot.BotAcceptDuelMinimumLevel = 10

# Automation

# How alt bots pick a quest reward when the quest offers a choice (other bots always pick themselves):
#   yes = always pick the best item themselves
#   no  = always list every reward and wait for you to choose with: r [item]
#   ask = take the reward themselves when only one is useful to them; list the useful ones and wait
#         for r [item] only when more than one is useful. So in one party some bots ask and some don't.
AiPlayerbot.AutoPickReward = yes

# Bots equip upgrades (Bots will equip any item obtained from looting or a quest if they are upgrades)
# Default: 0 (disabled)
AiPlayerbot.AutoEquipUpgradeLoot = 1

# An upgrade must beat the old item's stat weight by this factor to count (mod-playerbots parity, default 1.1: a +10% win swaps, an epsilon gain does not). 1.0 restores any-gain swaps.
AiPlayerbot.EquipUpgradeThreshold = 1.1

# Sync quests with player (Bots will complete quests the moment you hand them in. Bots will ignore looting quest items.)
# Default: 0 (disabled)
AiPlayerbot.SyncQuestWithPlayer = 0

# Bot completes its own quests the moment the real player hands the shared quest in
#AiPlayerbot.SyncQuestForPlayer = 0

# Bot automatically trains spells when talking to trainer (yes = train all available spells as long as the bot has the money, free = auto trains with no money cost, no = only list spells)
AiPlayerbot.AutoTrainSpells = yes

# Bot automatically picks talent points based on current spec (full = pick spec based on probability if multiple are like current spec, semi = only apply points if 1 spec looks like current spec, no = no auto talent points)
AiPlayerbot.AutoPickTalents = full

# Bots automatically learn trainable spells on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoLearnTrainerSpells = 1

# Bots automatically learn classquest reward spells on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoLearnQuestSpells = 1

# Your own alts (characters added with .bot add, and autonomous alt bots) also learn
# classquest reward spells on login and levelup. Trainer spells stay paid for them.
# Default: 0 (disabled)
AiPlayerbot.AutoLearnQuestSpellsAlts = 0

# Alt Bots automatically learn class spells from books dropped from dungeons and raids when leveled and they reached the required level of the book.
# Default: 0 (disabled)
AiPlayerbot.AutoLearnDroppedSpells = 0

# Hunter and warlock pets of pool bots and hired companions train themselves on every
# level-up: hunter pets get their family's best build within 4 active abilities and
# their training points, warlock demons get every Grimoire rank of their level.
# Default: 1 (enabled)
AiPlayerbot.PetAutoTrain = 1

# The same for your own alts' pets. A hunter alt's pet keeps the abilities you taught
# it yourself and ranks them up too; nothing it knows is ever removed.
# Default: 0 (disabled)
AiPlayerbot.PetAutoTrainAlts = 0

# Random Bots will pick quests on their own and try to complete
# Default: 1 (enabled)
# AiPlayerbot.AutoDoQuests = 1

# Mage/Warlock bots conjure a fresh stack of food/water/healthstones into
# the trade window on every trade, whoever opened it. Mages give food to
# everyone and water to mana users at the best rank both know for the
# trader's level; warlocks give one healthstone unless the trader carries
# one. Free and unlimited: no reagent, no mana, no cast.
# Default: 1 (enabled)
AiPlayerbot.AutoShareConjuredOnTrade = 1

# Pool-bot trading (issue #469, mod-playerbots EnableRandomBotTrading parity):
# 0 off (no stranger trades), 1 trusted (master, group, hire master only),
# 2 buy-only (bot takes, never gives), 3 sell-only (bot gives, never takes),
# 4 on (unrestricted). Owned/hired bots always trade with their master.
# Out-of-range values fail closed to 0.
# Default: 0 (off)
AiPlayerbot.PoolBotTradeMode = 0

# Trade-chat lines starting with one of these comma-separated prefixes never
# drive the trade action (donor TradeActionExcludedPrefixes parity): addon
# chatter such as Questie/DBM/RPLL lines cannot open a trade window.
# Default: "RPLL_H_,DBMv4"
AiPlayerbot.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4"

# Generate and persist the full TravelNode/navmesh cache at AI startup.
# This can load every map and perform a large database rebuild. Leave disabled
# unless a core path-filter implementation is available; the pinned Tortoise
# core currently disables this option and uses direct movement instead.
# Default: 0 (disabled)
# AiPlayerbot.GenerateTravelNodes = 0

# Generate and persist fish-location points when no FISH_LOCATION rows exist.
# This scans populated grids and writes a potentially large cache to World.
# Leave disabled for normal startup; deploy a precomputed named-location cache
# or enable only after the core supplies terrain-area queries; the pinned
# Tortoise core currently disables this option and uses direct fishing.
# Default: 0 (disabled)
# AiPlayerbot.GenerateFishLocations = 0

# Random Bots will also move to destinations when not seen by the player
# AiPlayerbot.EnableMinimalMove = 1

##################################################################################
#                                                                                #
# All other parameters are optional but can be changed by uncommenting them here #
#                                                                                #
##################################################################################

##################################################################################
#                                                                                #
# Bot probabilities                                                              #
#                                                                                #
##################################################################################
#
# AiPlayerbot.ClassRaceProb.<class>.<race> = <number>         #Probability Randombots will be allowed to login with this class and race. (default 100)
# All probabilities are relative setting all values to 200 is the same as setting all values to 5.
# For logging in bots the amount a race/class combo allowed is (<race/class probability>*totalBots/<total probability of all race/classes>)+1 (if not 0)
#
# These are overrides. The order of reading is default -> race -> class -> race+class.
# So if you set human to 50 and warrior to 75, human mage to 65 and orc warrior to 55:
# All humans except mage and warrior will have a 50% lower chance to be generated.
# All non-orc warriors will have a 75% lower chance to be generated.
# Human mages have a 65% lower chance to generate.
# Orc warriors have a 55% lower chance to generate.
#
# Source https://web.archive.org/web/20050115034332/http://www.warcraftrealms.com/census.php

# As an alternative to probability-based generation, you can enable:
# AiPlayerbot.ClassRace.UseFixedClassRaceCounts
# This will generate random bots based on a fixed total count per class/race combo as defined by:
# AiPlayerbot.ClassRaceProb.<class>.<race> = <number>
#
# AiPlayerbot.ClassRace.UseFixedClassRaceCounts = 0

