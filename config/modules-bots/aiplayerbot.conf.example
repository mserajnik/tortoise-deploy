#AiPlayerbot.EatDrinkMaxDistance = 1000.0


# Currently has no effect (read but unused).
# Max distance bot allowed to roam freely around master
#AiPlayerbot.MaxFreeMoveDistance = 150.0

# Currently has no effect (read but unused).
# Delay (in seconds) after master inactivity after which bots will start roaming freely around master
# Set to 0 to disable (bots will not be going places on their own when you are idle)
#AiPlayerbot.FreeMoveDelay = 30.0

# Bot can flee for enemy
AiPlayerbot.FleeingEnabled = 1

# Universal raid survival (issue #201): bomb carriers run BombRunoutDistance
# clear of the raid anchor; spread/flank steps use HazardEvasionDistance.
#AiPlayerbot.BombRunoutDistance = 30.0
#AiPlayerbot.HazardEvasionDistance = 12.0

# Custom Turtle raid tactics (issue #203): Emerald Sanctum (807), Lower
# Karazhan (532), Karazhan Crypt (800). Geometry-dependent behavior stays
# manual pending playtesting (#237); this gates the transition strategies.
AiPlayerbot.EnableCustomRaidTactics = 1

# Health/Mana levels
#AiPlayerbot.CriticalHealth = 20
#AiPlayerbot.LowHealth = 50
#AiPlayerbot.MediumHealth = 70
#AiPlayerbot.AlmostFullHealth = 90
#AiPlayerbot.LowMana = 15
#AiPlayerbot.MediumMana = 40

# Ordered pull (".bot action pull [seconds]" / ".bot action pullback [seconds]").
# The DPS join delay runs from the pull landing (pull) or from the tank back at
# the anchor (pullback); a per-command [seconds] argument (0-60) overrides the
# default. The return leg is hard-capped by PullBackMaxReturnTime.
#AiPlayerbot.PullDpsJoinDelay = 10
#AiPlayerbot.PullBackDpsJoinDelay = 3
#AiPlayerbot.PullBackMaxReturnTime = 15
# Random bot default strategies (applied after defaults)
AiPlayerbot.RandomBotCombatStrategies = +dps,+dps assist,-threat
AiPlayerbot.RandomBotNonCombatStrategies = +grind,+loot,+custom::say,+tfish,+wander,+rpg craft
#AiPlayerbot.RandomBotReactStrategies =
#AiPlayerbot.RandomBotDeadStrategies =
# Keep these empty so the spec/role defaults above remain authoritative for
# player-owned bots. Add explicit overrides only when intentionally changing a
# bot's role or autonomous behavior. The C++ fallback for owned bots adds
# +loot (corpse looting) on top of +return,+delayed roll.
AiPlayerbot.CombatStrategies = ""
#AiPlayerbot.NonCombatStrategies = "+return,+delayed roll,+loot"
#AiPlayerbot.ReactStrategies =
#AiPlayerbot.DeadStrategies =

# Toggle offheal and offdps strategies for hybrid classes.
#AiPlayerbot.EnableOffSpecStrategies = 1

# Quest items to leave (do not destroy)
#AiPlayerbot.RandomBotQuestItems = 6948,5175,5176,5177,5178,16309,12382,13704,11000,22754

# (Alt) bots will never sell or destroy epic or greater quality items.
# AiPlayerbot.BotsSaveEpics = 1

# PvP Restricted Zones (bots don't pvp)
#AiPlayerbot.PvpProhibitedZoneIds = 2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323

