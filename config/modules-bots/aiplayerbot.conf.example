# Applies a permanent buff to all bots.
# WorldBuff.Faction.Class.MinLevel.MaxLevel,EventID = spellId
# All bots:               Rallying Cry of the Dragonslayer for all bots
# AiPlayerbot.WorldBuff = 22888
# All horde                 Warchief's Blessing for all horde
# AiPlayerbot.WorldBuff.2 = 16609
# All level 40 bots         Spirit of Zandalar
# AiPlayerbot.WorldBuff.0.0.40 = 24425
# All warlocks between lvl1 and 10 volatile-infection & wandering-plague
# AiPlayerbot.WorldBuff.0.9.1.10 = 18149,3436
# All alliance lvl60 rogues      Plainsrunning & Sprint & Speed
# AiPlayerbot.WorldBuff.1.4.60 = 12566,11305,2379
# Darkmoon Faire - Elwynn Forest	Sayge's Dark Fortune of Damage
# AiPlayerbot.WorldBuff.0.0.0.0.0.4 = 23768

# Prefix for bot chat commands (e.g. follow, stay)
#AiPlayerbot.CommandPrefix =

# Separator between several bot commands in one chat message
#AiPlayerbot.CommandSeparator = \\

# Max AI iterations per tick
#AiPlayerbot.IterationsPerTick = 100

# Per-tick AI pass scheduling for a large random pool (party-bot latency).
# Bots owned by a real player — module-owned records and every bot bound to a
# master — are always updated first, every tick, with no budget. The random
# pool runs after them as one turn queue: after each turn a bot is due again
# when its AI asked to think next, never later than its situation allows
# (combat 400 ms, dead or battleground 1 s, teleport 100 ms, else 3 s), and a
# change of situation makes it due at once. Due bots run most overdue first
# relative to that cap until the budget is spent, so nobody is dropped.
#   PoolTickBudgetUs: microseconds of module work per tick for the pool turn
#       queue, added to CombatTickBudgetUs (the two make one budget).
#       0 = no budget at all (every due bot runs).
#       Values below 1000 are raised to 1000; 100000 is the ceiling.
#   PoolBudgetWhenTickOverMs: the budget only engages while the previous world
#       tick ran longer than this. 0 = budget on every tick (the default: with
#       the self-tuning budget below, a healthy server reclaims the full
#       ceiling on its own, so there is no need to gate behind slow ticks).
#   CombatTickBudgetUs: the second half of the same budget (it once fed a
#       separate combat pass; kept so existing configs keep their total).
#       0 = no budget at all. Default is 15000 (15 ms).
#   TargetWorldTickMs: self-tuning tick budget. Each tick the controller moves
#       the effective pool/combat budgets from the measured previous world
#       tick so the tick stays near this target: over it the budgets shrink
#       fast (x0.7/tick), at or under it they creep back (+1 ms/tick),
#       shrinking only above target + 10 ms, and only when cutting the
#       pool can bring the tick back: if the core (everything outside the
#       pool turns) alone keeps the tick over, the budgets hold instead of
#       making bots late for nothing. No hardware detection, just
#       feedback on tick time — a fast desktop keeps the full configured
#       ceilings, a weak machine backs off on its own. 0 = off (static
#       ceilings; also set PoolBudgetWhenTickOverMs=150 to restore the old
#       gate). Default is 100: player lag stays well under ~200 ms while a
#       large pool keeps its bots moving. Lower it (e.g. 50) for snappier
#       ping at the cost of slower bot turns on a busy server; a target
#       below what the core alone takes has no effect. If the server cannot
#       hold even 100, run fewer bots.
# The pass cost and whether the budget cut a pass are reported by the
# "TortoiseBots: BOTPERF ..." log line every ~30 s (LogLevel 1 or higher).
AiPlayerbot.PoolTickBudgetUs = 22000
AiPlayerbot.PoolBudgetWhenTickOverMs = 0
AiPlayerbot.CombatTickBudgetUs = 15000
AiPlayerbot.TargetWorldTickMs = 100

# Value cache refresh (performance experiment, off by default).
# A cached AI value with a check interval of N seconds has always refreshed
# every N/2 seconds (whole seconds, rounded down), so it recalculates about
# twice as often as its interval says. 1 = refresh after the full interval
# instead. Values with interval 0 or 1 (health, mana, auras, targets,
# inventory, ...) still recalculate on every read, and the values that sense
# the fight (attackers and their counts, aggro, possible targets, traps and
# void zones, boss target, AoE heal, enemy players), the free-move values
# (free move center/range, can free move: followers restart when the master
# runs off) and grind target keep the old rule.
# Everything else (travel, quest, vendor, group, ...) may react
# up to twice as late. Off until an A/B run shows the gain is worth it.
AiPlayerbot.ValueRefreshAtInterval = 0

# Bounded failure backoff for autonomous background work (issue #84).
# Repeated failures wait base, 2x, 4x, 8x, 16x up to the max before the
# action may run again. Combat, reactions, owner commands and owned bots
# are never throttled. Set base or max to 0 to disable entirely.
#AiPlayerbot.FailedActionRetryBase = 250
#AiPlayerbot.FailedActionRetryMax = 2000
#AiPlayerbot.FailedActionCacheTtl = 30000
#AiPlayerbot.FailedActionCacheMaxEntries = 64
# Delay between two short-time spells cast (Default 500)
AiPlayerbot.GlobalCooldown = 1500

# Max wait time when moving
#AiPlayerbot.MaxWaitForMove = 3000

# Delay between two bot actions (default 100)
AiPlayerbot.ReactDelay = 100

# Inactivity delay
AiPlayerbot.PassiveDelay = 10000

# Minimum delay between repeating actions (chat messages, emotes etc)
AiPlayerbot.RepeatDelay = 5000

AiPlayerbot.RpgDelay = 10000

AiPlayerbot.SitDelay = 20000

AiPlayerbot.LootDelayDelay = 1000

# A queued action basket expires after this many ms
#AiPlayerbot.ExpireActionTime = 5000
# Dispel is skipped for auras with less than this many ms left
#AiPlayerbot.DispelAuraDuration = 2000
# Delay between flee/return attempts after a failed move home
#AiPlayerbot.ReturnDelay = 7000

#Distances
AiPlayerbot.SightDistance = 60.0
AiPlayerbot.SpellDistance = 26.0
AiPlayerbot.ShootDistance = 26.0
#AiPlayerbot.ReactDistance = 150.0
#AiPlayerbot.FarDistance = 20.0
#AiPlayerbot.AggroDistance = 22.0
#AiPlayerbot.WalkDistance = 5.0
#AiPlayerbot.WanderMinDistance = 5.0
#AiPlayerbot.WanderMaxDistance = 50.0
#AiPlayerbot.TargetPosRecalcDistance = 0.1
#AiPlayerbot.GrindDistance = 75.0
#overall loot distance
#AiPlayerbot.LootDistance = 25.0
#loot distance when bot is a group member (not leader)
#AiPlayerbot.GroupMemberLootDistance = 15.0
#overall gathering distance
#AiPlayerbot.GatheringDistance = 15.0
#gathering distance when bot is a group member (not leader)
#AiPlayerbot.GroupMemberGatheringDistance = 10.0
#gathering distance when bot is a group member (not leader) and has active player master (if player is group leader)
#AiPlayerbot.GroupMemberGatheringDistanceWithActiveMaster = 5.0
#AiPlayerbot.FleeDistance = 8.0
#AiPlayerbot.TooCloseDistance = 5.0
#AiPlayerbot.MeleeDistance = 1.5
#AiPlayerbot.FollowDistance = 1.5
#AiPlayerbot.RaidFollowDistance = 4.0
#AiPlayerbot.WhisperDistance = 6000.0
#AiPlayerbot.ContactDistance = 0.5
#AiPlayerbot.AoeRadius = 5.0
AiPlayerbot.RpgDistance = 200
#AiPlayerbot.ProximityDistance = 20.0
#Distances to limit bots eating/drinking while following a master.
#Inside this range eating/drinking is cut short or prevented to stay near master.
#AiPlayerbot.EatDrinkMinDistance = 5.0
#AiPlayerbot.EatDrinkMaxDistance = 1000.0


# Bot can flee for enemy
AiPlayerbot.FleeingEnabled = 1

# Pool warriors and rogues hold their ground (opt-in). 1 = pool and free bots
# of these two classes get no generic "flee" combat strategy, so they no longer
# break off on panic (critical health, no mana gate for rage/energy),
# outnumbered or critical health: they fight on with their own defensive kit,
# like mod-playerbots melee. 0 = unchanged flee. Bots with a real player
# master never get this flee anyway. Takes effect after a server restart.
#AiPlayerbot.PoolMeleeHoldGround = 0

# Alt-bots (issue #872, off by default). 1 = an alt you brought in with `.bot add`
# keeps playing on its own when you kick it from your party (or the party
# breaks up): it quests, grinds and travels like a pool bot, with protections
# for your gear, gold and talents, and takes one pool bot's slot while it is
# out. `.bot remove`, `.bot add` again or logging in on the alt ends it.
# Hardcore characters are refused. 0 = a kicked alt stays your companion.
#AiPlayerbot.AltBots = 0

# 1 = alt-bots log out when their owner logs out. 0 = they keep playing until
# `.bot remove` (or a server restart; they do not come back after one).
#AiPlayerbot.AltBotsLogoutWithOwner = 0

# Universal raid survival (issue #201): bomb carriers run away from the
# raid's centre until no group member is within BombRunoutDistance, then
# stop; spread/flank steps use HazardEvasionDistance.
#AiPlayerbot.BombRunoutDistance = 30.0
#AiPlayerbot.HazardEvasionDistance = 12.0

# Custom Turtle raid tactics (issue #203): Emerald Sanctum (807), Lower
# Karazhan (532), Karazhan Crypt (800). Geometry-dependent behavior stays
# manual pending playtesting (#237); this gates the transition strategies.
AiPlayerbot.EnableCustomRaidTactics = 1

# Health/Mana levels
#AiPlayerbot.CriticalHealth = 20
#AiPlayerbot.LowHealth = 50
#AiPlayerbot.MediumHealth = 70
#AiPlayerbot.AlmostFullHealth = 90
#AiPlayerbot.LowMana = 15
#AiPlayerbot.MediumMana = 40

# Ordered pull (".bot action pull [seconds]" / ".bot action pullback [seconds]").
# The DPS join delay runs from the pull landing (pull) or from the tank back at
# the anchor (pullback); a per-command [seconds] argument (0-60) overrides the
# default. The return leg is hard-capped by PullBackMaxReturnTime.
#AiPlayerbot.PullDpsJoinDelay = 10
#AiPlayerbot.PullBackDpsJoinDelay = 5
#AiPlayerbot.PullBackMaxReturnTime = 15

# Ranged opening for commanded pulls (".bot action pull|pullback", ".bot cmd
# pull|pullback"). A plain pull walks the tank in; with RangedPull = 1 the tank
# shoots instead (gun, bow, crossbow, thrown weapon with its ammo; a hunter or
# caster uses its pull spell) when the mob is in sight and in shot range and
# either no path leads to it (a ledge) or it is farther than
# RangedPullMeleeApproach yards (walking in would meet the next pack). The order
# word `ranged` (".bot action pull 10 ranged") asks for it on any pull and is
# honoured whatever this says. A pullback always opens from range. A tank
# without the weapon or ammo walks in and the answer says why. Commanded pulls
# only: the tank's own automatic pulls are unchanged.
#AiPlayerbot.RangedPull = 1
#AiPlayerbot.RangedPullMeleeApproach = 20
# Random bot default strategies (applied after defaults)
# Note: non-tank bots grouped with a real-player master (outside BGs) get `threat` added back
# after this list, so `-threat` here only affects masterless pool bots.
# No "+dps" here: for a priest "dps" is the Shadow spec strategy, and adding it
# swaps a Holy or Discipline pool priest onto the Shadow rotation in combat
# (no Mind Flay or Shadowform talents, so it fills with Smite). The spec
# defaults already give pool healers off-spec damage through "offdps".
# A bot whose spec defaults chose "tank assist" (Protection warrior/paladin,
# bear) keeps it: "+dps assist" here no longer swaps a tank's sibling out.
AiPlayerbot.RandomBotCombatStrategies = +dps assist,-threat
# Inside a dungeon or raid the non-combat list skips +grind, +travel, +tfish, +rpg,
# +rpg craft and +wander, so a pool bot in a party keeps its follow leash there.
# Zoning in drops those strategies too; leaving gives back only what was dropped
# (never +wander next to follow), so a strategy you turned off stays off.
AiPlayerbot.RandomBotNonCombatStrategies = +grind,+loot,+custom::say,+tfish,+wander,+rpg craft
#AiPlayerbot.RandomBotReactStrategies =
#AiPlayerbot.RandomBotDeadStrategies =
# Keep these empty so the spec/role defaults above remain authoritative for
# player-owned bots. Add explicit overrides only when intentionally changing a
# bot's role or autonomous behavior. The C++ fallback for owned bots adds
# +loot (corpse looting) on top of +return,+delayed roll.
AiPlayerbot.CombatStrategies = ""
#AiPlayerbot.NonCombatStrategies = "+return,+delayed roll,+loot"
#AiPlayerbot.ReactStrategies =
#AiPlayerbot.DeadStrategies =

# Toggle offheal and offdps strategies for hybrid classes.
#AiPlayerbot.EnableOffSpecStrategies = 1

# Quest items to leave (do not destroy)
#AiPlayerbot.RandomBotQuestItems = 6948,5175,5176,5177,5178,16309,12382,13704,11000,22754

# (Alt) bots will never sell or destroy epic or greater quality items.
# AiPlayerbot.BotsSaveEpics = 1

# PvP Restricted Zones (bots don't pvp)
#AiPlayerbot.PvpProhibitedZoneIds = 2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323

# Pool bots turn on the same PvP preference /pvp sets at every login, so players can attack them anywhere (1).
# 0 = no bot sets /pvp. Owned and hired bots are never affected.
AiPlayerbot.RandomBotForcePvp = 1

# Open-world PvP seeking for free pool bots. 0 = off, 1 = seek real players only, 2 = seek players and enemy bots.
# An unflagged player is never attacked. Owned/hired bots and bots grouped with a real player never seek.
AiPlayerbot.WorldPvpSeek = 2

# Share of free pool bots that hold the "world pvp" seek role (0-100).
#AiPlayerbot.WorldPvpSeekBotPercent = 25

# Minutes between re-rolls of the seek role (with jitter), never while the bot is in combat.
#AiPlayerbot.WorldPvpSeekRerollMinutes = 30

# Spells every random bot will learn on randomize. Keep this list limited to
# spells present in the Vanilla/Tortoise data set. Empty by default (disabled);
# a value is a comma separated spell id list, e.g. 3273,8386.
# AiPlayerbot.RandomBotSpellIds =


#AiPlayerbot.OpenGoSpell = 6477

# Intervals
AiPlayerbot.RandomBotUpdateInterval = 500
AiPlayerbot.RandomBotsMaxLoginsPerInterval = 30
#AiPlayerbot.MaxRandomBotInWorldTime = 21600
# A pool bot below level 60 that earns no XP for this many minutes is
# relogged (a relog clears whatever left it idle). 0 = off.
#AiPlayerbot.RandomBotStallRelogMinutes = 45
#AiPlayerbot.MinRandomBotRandomizeTime = 21600
#AiPlayerbot.MaxRandomBotRandomizeTime = 86400
# Legacy alias read only when AiPlayerbot.MaxRandomBotRandomizeTime is unset.
#AiPlayerbot.MaxRandomRandomizeTime = 86400
#AiPlayerbot.MinRandomBotChangeStrategyTime = 1800
#AiPlayerbot.MaxRandomBotChangeStrategyTime = 7200
#AiPlayerbot.MaxRandomBotsPriceChangeInterval = 172800

#######################################
#
# Auction house settings
#
# (0-1) If bot should query current AH listings outside of AH when determining whether the item is worth posting to AH
# Disabled by default for performance concerns, but you REALLY want to enable it for nicer logic
# AiPlayerbot.ShouldQueryAHListingsOutsideOfAH = 1
#
# List of item ids which bot will prefer to put to AH rather than selling to vendor (these are overrides).
# This list has priority over AiPlayerbot.VendorOverAHItemIds.
# Empty by default (disabled); a value is a comma separated item id list.
# AiPlayerbot.AhOverVendorItemIds =
#
# List of item ids which bot will prefer to sell to vendor rather than selling to AH (these are overrides)
# (Bot will never buy these items from vendor to resell at AH as well).
# Empty by default (disabled); a value is a comma separated item id list.
# AiPlayerbot.VendorOverAHItemIds =
#
# List of item ids bots never post to the auction house (owner-editable).
# Default posts nothing for 18256 (Imbued Vial); a value is a comma separated item id list.
AiPlayerbot.AhSellBlacklist = 18256
#
# (0-1) Whether bot should check ALL auction house listings when browsing (by default only checks a small amount)
# AiPlayerbot.BotCheckAllAuctionListings = 0
#
# (seconds) Interval between auction house price mirror refreshes (5-3600)
# AiPlayerbot.AuctionPriceRefreshInterval = 60
#
#######################################

# rpg jump is a strategy that makes bot do random jumps

# Chance to get jump strategy for non combat
AiPlayerbot.JumpNoCombatChance = 0.50
# Chance to get jump strategy for combat, only for melee bots
AiPlayerbot.JumpMeleeInCombatChance = 0.50
# Chance to jump every second, if rpg jump strategy added
AiPlayerbot.JumpRandomChance = 0.20
# Chance to jump in place instead of forward
AiPlayerbot.JumpInPlaceChance = 0.50
# Chance to jump backward instead of forward
AiPlayerbot.JumpBackwardChance = 0.10
# Jumping height limit
AiPlayerbot.JumpHeightLimit = 60
# Land a bot whose near teleport (Banish, a summon) ends in mid-air: the floor
# under the destination is probed and the bot falls to it (about the fall time
# plus a second), instead of hovering there until the next teleport. Changes
# every near teleport, so off by default.
AiPlayerbot.TeleportLandingFall = 0
# Vertical jump speed
#AiPlayerbot.JumpVSpeed = 7.96
# Horizontal jump speed
#AiPlayerbot.JumpHSpeed = 7.0
# Add rpg jump strategy if bot is with real player
AiPlayerbot.JumpWithPlayer = 0
# Add rpg jump strategy in BG
AiPlayerbot.JumpInBg = 0
# Hold the ready-check confirm until buffs settle (grace) or a 30 s cap fires,
# instead of answering ready and buffing through the pull. Off by default;
# the readiness text report is immediate either way.
AiPlayerbot.ForceRebuffOnReadyCheck = 0

# Use jump if can not find a proper path to follow, if possible
AiPlayerbot.JumpFollow = 1
# Use jump if can not find a proper path to enemy, if possible
AiPlayerbot.JumpChase = 1

# Allow knockbacks work on bots
AiPlayerbot.UseKnockback = 1

# Set 'wander' as a default following strategy instead of 'follow' (Bots have freedom to move around while near master)
# Applies to bots without a real-player master; a bot whose master is a real player always rebuilds with 'follow'
#AiPlayerbot.UseWanderAsDefaultFollowStrategy = 1

# Default bot formation
#AiPlayerbot.DefaultFormation = chaos

# Raid/dungeon follow wedge: inside an instance a group follows in a 150 degree
# arc behind the leader (near formation, raid follow distance, two rings above
# ten followers), and a follower more than 20 yd behind, out of combat, walks
# the leader's own path. An explicit .bot formation order still wins.
# 0 keeps the configured formation everywhere.
#AiPlayerbot.RaidFollowWedge = 0

# Debug switches
#AiPlayerbot.SpellDump = 0
# Unrelated to ActionLogScope: this keeps the engine's per-action detail lines
# (server log at detail level, and their copy in the action log) to bots that
# are in a group. Its value 1 is what runs when the line is left out.
#AiPlayerbot.LogInGroupOnly = 1
#AiPlayerbot.LogValuesPerTick = 0
#AiPlayerbot.RandomChangeMultiplier = 1

AiPlayerbot.PerfMonEnabled = 0


##################################################################################
#                                                                                #
#                                 !!EXPERIMENTAL!!                               #
#                                                                                #
##################################################################################

# Bot cheats. Same as "/w <bot> cheat (+/-/?) <cheatcode>" but only globally for all bots.
# Values: taxi            (all nodes learned)
#         item            (unlimited items for spells)
#         gold            (free repair, vendor, ect.)
#         health          (fast regen)
#         mana            (fast regen)
#         power           (fast regen)
#         cooldown        (no cooldowns)
#         repair          (no durability of ress sickness)
#         movespeed       (very fast movespeed)
#         attackspeed     (very fast attackspeed)
#         breath          (underwater breathing)
#         quest           (quests complete instantly)
# Cheats for alts
AiPlayerbot.BotCheats = repair,breath
# Cheats for randombots
AiPlayerbot.RndBotCheats = repair,breath,item

# There is no ".bot self" in TortoiseBots: a character you are playing never turns into a bot.
# Only one effect of this key is left, the "always online" lists below: with 5 every character
# they would cover is kept online as a bot and the lists name the exceptions; with any other
# value (default 1) only the listed accounts and characters are.
# AiPlayerbot.SelfBotLevel = 1

# Accounts/characters kept always online as bots (with SelfBotLevel = 5: kept offline instead)
# AiPlayerbot.ToggleAlwaysOnlineAccounts =
# AiPlayerbot.ToggleAlwaysOnlineChars =


# Allowed log files. See SPP_MAP for more information
# https://github.com/mostlikely4r/spp-map
# On by default so a bug report can carry them: bot_events.csv (bot decisions), deaths.csv (bot deaths and killers).
# Opt-in diagnostics: travel_route_gate.csv (rejected travel routes), ghost_moves.csv (dead bots walking to their corpse), pvp_seek.csv (open-world PvP seek grants and engagements).
# To turn the bot CSV logs off, leave this list empty (AiPlayerbot.AllowedLogFiles =). The dashboard does not need
# these files: it is fed over UDP by the observability emitter, so activity, deaths and kills keep flowing.
AiPlayerbot.AllowedLogFiles = bot_events.csv,deaths.csv

# Opt-in engaged raid boss threat snapshots (2 s) and spell-damage packet observations.
# Requires bot_events.csv above. Hit health is a sample/estimate, not exact post-hit health.
AiPlayerbot.RaidBossDiagnostics = 0

# Per-fight combat numbers of every bound group for the observability dashboard: casts, damage, healing and overheal, damage taken, deaths with their last hits, and debuff uptime on the fought unit; one COMBAT_FIGHT datagram per fight and a rolling 10 s window. While on, a damage, heal or cast event of a player outside every bound group costs one atomic bit test (no lock); a member's event takes the monitor's lock. Needs AiPlayerbot.Observability.
# 0 - off (Default)
# 1 - on
AiPlayerbot.CombatMonitor = 0

# The boss timeline in every fight record (owner tool): the fought boss's health every 2 s with his entry (phase), each
# change of his current victim (guid, name, that bot's role) and every apply/remove of a watched aura on our bots (the
# spell ids of the world table ai_combat_aura_watch). Each array is capped (600 samples, 400 victim changes, 1000 aura
# events, oldest dropped) and the timeline is left out of a payload that has to shrink. Needs AiPlayerbot.CombatMonitor.
# 0 - off (Default)
# 1 - on
AiPlayerbot.CombatTimeline = 0

# Days of bot logs to keep. The live file is plain text; every hour and at server start it is packed into
# <name>_<date>_<time>.csv.gz next to it (named after the time it was closed), and packs older than this
# are deleted. 0 = never delete. Only files listed in AiPlayerbot.AllowedLogFiles above are written, so
# leaving that list empty stops the log files (and their packs) entirely.
AiPlayerbot.LogRetentionDays = 3

# At server start, look up the newest TortoiseBots and TortoiseBotsManager releases on GitHub once, in
# the background (needs curl, standard on Linux and Windows 10+). Players then see the newest versions at
# login and in the addon. Offline or failed lookups change nothing. 0 = never connect.
# This is turned off by default in tortoise-deploy because its update process
# is the only way to get a newer module release. Turning it on has no effect,
# because the image does not contain curl, which the check needs.
AiPlayerbot.UpdateCheck = 0

# Filters certain actions from showing up in 'nc +debug' and 'nc +debug action'
# AiPlayerbot.DebugFilter = add gathering loot,check values,emote,check mount state,jump

